<Window x:Class="Cultos.App.ChurchProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de iglesia"
        Width="900"
        Height="650"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PERFIL DE IGLESIA"
                               Foreground="{StaticResource Subtle}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Identidad visual"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,14"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#0D0E0C"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="LogoPreview" Stretch="Uniform" Margin="24"/>
                        <TextBlock x:Name="LogoPlaceholder"
                                   Text="Sin logo"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button Click="ChooseLogo_Click" Margin="0,0,0,7">Elegir logo…</Button>
                    <Button Click="ChooseBackground_Click">Elegir fondo predeterminado…</Button>
                    <TextBlock x:Name="BackgroundStateText"
                               Text="Sin fondo predeterminado"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,9,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                    <TextBlock Text="El perfil puede exportarse con sus escenas y recursos para instalar la misma configuración en otra iglesia o computadora."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="DATOS GENERALES"
                               Foreground="{StaticResource Subtle}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Configuración de la congregación"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,18"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nombre de la iglesia" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nombre corto" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="ShortNameBox"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Ubicación" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="LocationBox"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Traducción bíblica preferida" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="BibleTranslationBox" ToolTip="Ej.: RVR1960, NVI, etc."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Himnario preferido" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="HymnalBox"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Color de acento" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="AccentBox" Text="#C9AC70"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="Formato hexadecimal, por ejemplo #C9AC70."
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               VerticalAlignment="Bottom"
                               Margin="14,0,0,10"/>
                </Grid>

                <Border Grid.Row="5"
                        Background="{StaticResource PanelRaised}"
                        CornerRadius="8"
                        Padding="14"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="PORTABILIDAD"
                                   Foreground="{StaticResource Subtle}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="El paquete incluye este perfil, la configuración de escenas y los archivos utilizados por ellas."
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ExportProfile_Click" Margin="0,0,8,0">Exportar perfil…</Button>
                            <Button Click="ImportProfile_Click">Importar perfil…</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="6" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Click="Cancel_Click" Margin="0,0,8,0">Cerrar</Button>
                    <Button Grid.Column="2" Click="Save_Click" Style="{StaticResource PrimaryButton}">Guardar perfil</Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
