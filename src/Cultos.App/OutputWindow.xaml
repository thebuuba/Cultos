<Window x:Class="Cultos.App.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Salida de congregación"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Background="Black"
        SizeChanged="Window_SizeChanged">
    <Grid x:Name="Root" Background="Black">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="PresentationSurface" Width="1600" Height="900" Background="#151915" ClipToBounds="True">
                <Image x:Name="OutputImage" Visibility="Collapsed" Stretch="Uniform"/>
                <MediaElement x:Name="OutputVideo"
                              Visibility="Collapsed"
                              Stretch="Uniform"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              MediaFailed="OutputVideo_MediaFailed"
                              MediaEnded="OutputVideo_MediaEnded"/>
                <TextBlock x:Name="OutputText"
                           Foreground="#F7F3E8"
                           FontFamily="Segoe UI"
                           FontSize="62"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="150"
                           MaxWidth="1300"/>
            </Grid>
        </Viewbox>
        <wv2:WebView2 x:Name="OutputWeb"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</Window>
