<Window x:Class="Cultos.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cultos · Producción visual" Width="1440" Height="900" MinWidth="1180" MinHeight="720" Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="#161614" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Accent}"><TextBlock Text="C" Foreground="#171611" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="Cultos" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Producción visual" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ServiceNameText" Text="Culto divino" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock x:Name="SaveStateText" Text="Guardado" Foreground="{StaticResource Muted}"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="LiveBadge" Visibility="Collapsed" Background="#3A201E" CornerRadius="6" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="●  EN VIVO" Foreground="#F2B0AA" FontWeight="Bold"/></Border><Button Click="OpenDisplay_Click" Margin="0,0,8,0">▣ Configurar pantalla</Button><TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="16" Margin="8,0"/><Button Click="Settings_Click">⚙</Button></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="300"/><ColumnDefinition Width="360"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#151513" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="10,16"><Button Content="⌂  Inicio" HorizontalContentAlignment="Left" Margin="0,0,0,6"/><Button Content="☷  Orden del culto" HorizontalContentAlignment="Left" Margin="0,0,0,6"/><Button Content="▤  Biblia" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="BibleNav_Click"/><Button Content="♫  Himnario" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="HymnNav_Click"/><Button Content="♪  Canciones" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="SongsNav_Click"/><Button Content="▧  Multimedia" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="MediaNav_Click"/><Button Content="◫  Diseños" HorizontalContentAlignment="Left" Margin="0,0,0,6"/><Button Content="▱  Cultos guardados" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Services_Click"/></StackPanel><Border Grid.Row="1" Margin="10,10,10,16" Padding="10" CornerRadius="8" Background="{StaticResource PanelRaised}"><StackPanel><TextBlock Text="Iglesia local" FontWeight="SemiBold"/><TextBlock Text="Guardado en este equipo" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border></Grid></Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="BIBLIOTECA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="LibraryTitle" Text="Biblia" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,12"/></StackPanel><TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchBox_TextChanged" ToolTip="Buscar por referencia, número, título o palabras"/><ListBox x:Name="LibraryList" Grid.Row="2" Margin="0,12,0,8" SelectionChanged="LibraryList_SelectionChanged" MouseDoubleClick="LibraryList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="10" Background="{StaticResource PanelRaised}" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Click="AddLibraryItem_Click" Background="#2C291F" BorderBrush="{StaticResource Accent}">＋ Agregar al orden</Button></Grid></Border>
   <Border Grid.Column="2" Background="#171715" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="ORDEN DEL CULTO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ItemCountText" Text="0 elementos" Margin="0,3,0,12"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddFreeText_Click">＋ Agregar</Button></Grid><ListBox x:Name="RunList" Grid.Row="1" SelectionChanged="RunList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="9" Background="{StaticResource PanelRaised}" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="☷" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Click="MoveUp_Click">↑</Button><Button Click="MoveDown_Click" Margin="6,0">↓</Button><Button Click="RemoveItem_Click">Eliminar</Button></StackPanel></Grid></Border>
   <Grid Grid.Column="3" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.35*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="VISTA PREVIA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PreviewTitle" Text="Selecciona contenido" FontWeight="SemiBold" FontSize="16"/></StackPanel><TextBlock Text="16:9" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
    <Border Grid.Row="1" Margin="0,10" Background="#242823" BorderBrush="#4D5047" BorderThickness="1" CornerRadius="8"><TextBlock x:Name="PreviewContent" Text="Selecciona un elemento para preparar la salida" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="44" MaxWidth="650"/></Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Click="Previous_Click">← Anterior</Button><Button Click="SendLive_Click" Background="{StaticResource Accent}" Foreground="#171611" BorderBrush="{StaticResource Accent}" FontWeight="Bold" Margin="8,0" Padding="24,10">ENVIAR EN VIVO</Button><Button Click="Next_Click">Siguiente →</Button></StackPanel>
    <Grid Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="● EN VIVO" Foreground="#EF8B82" FontWeight="Bold"/><TextBlock x:Name="LiveTitle" Text="  Sin contenido" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="DisplayStateText" Text="Pantalla no iniciada" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
    <Border Grid.Row="4" Margin="0,10" Background="#101010" BorderBrush="{StaticResource Live}" BorderThickness="2" CornerRadius="8"><TextBlock x:Name="LiveContent" Text="Sin contenido en vivo" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36"/></Border>
    <WrapPanel Grid.Row="5"><Button Click="Black_Click" Margin="0,0,6,6">■ Pantalla negra (B)</Button><Button Click="Clear_Click" Margin="0,0,6,6">✕ Limpiar (C)</Button><Button Click="RemoveText_Click" Margin="0,0,6,6">T̶ Quitar texto</Button><Button Click="Logo_Click" Margin="0,0,6,6">◇ Logotipo</Button><Button Click="Export_Click" Margin="0,0,6,6">⇧ Copia</Button><Button Click="Import_Click" Margin="0,0,6,6">⇩ Importar</Button></WrapPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#151513" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"><Grid Margin="14,0"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="← → Navegar · Espacio Enviar · B Pantalla negra · C Limpiar · F5 Salida externa"/><TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Text="Listo · modo offline"/></Grid></Border>
 </Grid>
</Window>
