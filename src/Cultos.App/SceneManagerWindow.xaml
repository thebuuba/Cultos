<Window x:Class="Cultos.App.SceneManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrador de escenas"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="2,0,2,10">
                    <TextBlock Text="ESCENAS" Foreground="{StaticResource Subtle}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Orden y acceso rápido" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <ListBox x:Name="SceneListBox"
                         Grid.Row="1"
                         SelectionChanged="SceneListBox_SelectionChanged"
                         DisplayMemberPath="Name"/>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="New_Click" Margin="0,0,5,0" ToolTip="Nueva escena">＋</Button>
                    <Button Grid.Column="1" Click="MoveUp_Click" Margin="0,0,5,0" ToolTip="Mover a la izquierda">←</Button>
                    <Button Grid.Column="2" Click="MoveDown_Click" Margin="0,0,5,0" ToolTip="Mover a la derecha">→</Button>
                    <Button Grid.Column="3" Click="Delete_Click" ToolTip="Eliminar">✕</Button>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CONFIGURACIÓN DE ESCENA"
                               Foreground="{StaticResource Subtle}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="EditorTitle"
                               Text="Selecciona una escena"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,18"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nombre" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tipo" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TypeBox"
                                  Height="38"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelRaised}"
                        CornerRadius="7"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Contenido preparado" Foreground="{StaticResource Muted}" FontSize="10"/>
                        <TextBlock x:Name="ContentStateText"
                                   Text="Sin contenido"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="BuiltInText"
                                   Text=""
                                   Foreground="{StaticResource Subtle}"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LogoOptionsPanel"
                        Grid.Row="3"
                        Background="#151613"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Presentación de Logo" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Intervalo (segundos)" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="LogoIntervalBox" Grid.Column="1" Text="8" MaxWidth="100" HorizontalAlignment="Left"/>
                        </Grid>
                        <CheckBox x:Name="LogoLoopBox"
                                  Content="Repetir presentación continuamente"
                                  IsChecked="True"
                                  Margin="0,10,0,0"
                                  Foreground="{StaticResource Text}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="Las escenas predeterminadas pueden renombrarse y reordenarse. Su tipo base se mantiene para evitar romper el flujo del programa."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Click="Close_Click" Margin="0,0,8,0">Cerrar</Button>
                    <Button Grid.Column="2" Click="Save_Click" Style="{StaticResource PrimaryButton}">Guardar cambios</Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
