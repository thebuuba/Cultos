                      <Button x:Name="ChooseOutputButton" Click="DisplayClick" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" MinHeight="36" Padding="8,0,8,0" Margin="0" AutomationProperties.Name="Elegir pantalla de salida" ToolTip="Elegir pantalla de salida">
