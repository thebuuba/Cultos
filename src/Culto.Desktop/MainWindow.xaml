<Window x:Class="Culto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Culto.Desktop"
        Title="Culto Studio — Consola de iglesia" Width="1480" Height="900"
        MinWidth="1180" MinHeight="680" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:OrderNumberConverter x:Key="OrderNumberConverter"/>
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent">
              <Border x:Name="Grip" Background="{StaticResource BorderBrush}" Width="2" Height="42" CornerRadius="1" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AmberBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="16" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectedBrush}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="#677659"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="OrderItemTemplate">
      <Grid ToolTip="{Binding Title}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="26" Height="28" CornerRadius="8" Background="{StaticResource CanvasBrush}" VerticalAlignment="Top">
          <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="EN VIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LiveBrush}" Margin="10,0,0,0"
                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LibraryItemTemplate">
      <Grid ToolTip="{Binding Title}" MinHeight="30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="KindBadge" Width="30" Height="30" CornerRadius="10" Background="#D1BEEA" VerticalAlignment="Center">
          <Path x:Name="KindIcon" Data="M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,7 L 13,7 M 7,10 L 13,10 M 7,13 L 11,13"
                Stroke="#33383B" StrokeThickness="1.4" Width="15" Height="17" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Video">
          <Setter TargetName="KindIcon" Property="Data" Value="M 5,3 L 17,10 L 5,17 Z"/>
          <Setter TargetName="KindBadge" Property="Background" Value="#B5E4CC"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Audio">
          <Setter TargetName="KindBadge" Property="Background" Value="#EFC6AD"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 8,14 L 8,4 L 17,2 L 17,12 M 8,14 C 8,18 1,18 1,15 C 1,12 8,12 8,14 M 17,12 C 17,16 10,16 10,13 C 10,10 17,10 17,12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image">
          <Setter TargetName="KindBadge" Property="Background" Value="#A7D4E6"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 2,3 L 18,3 L 18,17 L 2,17 Z M 2,14 L 8,8 L 13,13 L 16,10 L 18,12"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="14,8,14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="14" Padding="8,6">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FileMenuButton" Content="_Archivo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Archivo">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Nuevo culto" Click="NewPlanClick"/>
            <MenuItem Header="Abrir culto…" Click="OpenPlanClick"/>
            <MenuItem Header="Guardar una copia…" InputGestureText="Ctrl+S" Click="SavePlanClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="LibraryMenuButton" Content="_Biblioteca" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Administrar biblioteca">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Añadir archivos…" Click="ImportFilesClick"/>
            <MenuItem Header="Importar carpeta de himnos…" Click="ImportFolderClick"/>
            <MenuItem Header="Importar Biblia…" Click="ImportBibleClick"/>
            <Separator/>
            <MenuItem Header="Capturar una pantalla…" Click="CaptureClick"/>
            <MenuItem Header="Editar el contenido seleccionado…" Click="EditLibraryClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="SettingsMenuButton" Content="_Configuración" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Configuración">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Pantallas y salida…" Click="DisplayClick"/>
            <MenuItem x:Name="RemoteButton" Header="Mando móvil…" Click="RemoteClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="Culto actual" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="PlanNameBox" Text="Culto del sábado" Width="240" FontSize="13" Padding="10,5" MinHeight="32"
                 LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/>
      </StackPanel>
    </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.36*" MinWidth="250" MaxWidth="340"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*" MinWidth="390"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="0.55*" MinWidth="330" MaxWidth="500"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Orden del culto" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="PlanCountText" Text="0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Grid.Column="2" Content="⋯" Click="OpenActionsClick" Padding="8,2" MinHeight="30" FontSize="18" AutomationProperties.Name="Organizar el orden">
              <Button.ContextMenu><ContextMenu>
                <MenuItem Header="Subir elemento" Click="MoveUpClick"/>
                <MenuItem Header="Bajar elemento" Click="MoveDownClick"/>
                <Separator/>
                <MenuItem Header="Quitar del orden" Click="RemoveCueClick"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <local:OrderListBox x:Name="PlanList" ItemTemplate="{StaticResource OrderItemTemplate}" Style="{StaticResource {x:Type ListBox}}"
                     SelectionChanged="PlanSelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="PlanMouseDown" PreviewMouseLeftButtonUp="PlanMouseUp" MouseDoubleClick="PlanDoubleClick" MouseMove="PlanMouseMove" Drop="PlanDrop" AutomationProperties.Name="Orden de culto"/>
            <TextBlock x:Name="PlanEmptyText" Text="Orden vacío" Style="{StaticResource MutedText}" Margin="12,24" TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="AddOrderButton" Background="{StaticResource SelectedBrush}" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource SelectedBrush}" Click="OpenActionsClick" MinHeight="40" Padding="10,5" HorizontalContentAlignment="Center" AutomationProperties.Name="Agregar al orden de culto">
                <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="23" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Agregar" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu><ContextMenu>
                  <MenuItem x:Name="AddOrderLibrary" Header="Himno o contenido de biblioteca…" Tag="0" Click="AddOrderSourceClick"/>
                  <MenuItem x:Name="AddOrderBible" Header="Pasaje de la Biblia…" Tag="1" Click="AddOrderSourceClick"/>
                  <MenuItem x:Name="AddOrderText" Header="Texto o anuncio…" Tag="2" Click="AddOrderSourceClick"/>
                  <Separator/>
                  <MenuItem Header="Videos, imágenes o audio desde archivos…" Click="AddOrderFilesClick"/>
                </ContextMenu></Button.ContextMenu>
              </Button>
              <Button Grid.Column="1" x:Name="NotesToggleButton" Content="Notas" Click="ToggleNotesClick" Margin="6,0,0,0" MinHeight="40" Padding="8,5" FontSize="12" AutomationProperties.Name="Notas del elemento"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="3" x:Name="NotesPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Notas privadas" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
            <TextBox x:Name="NotesBox" Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" LostFocus="NotesChanged" AutomationProperties.Name="Notas privadas del elemento"/>
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" AutomationProperties.Name="Ancho del orden de culto"/>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12,14,14">
        <TabControl x:Name="ContentTabs" SelectionChanged="ContentTabChanged">
          <TabItem Header="Himnario y medios">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Buscar himno o contenido" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                  <TextBox x:Name="LibrarySearch" TextChanged="LibrarySearchChanged" KeyDown="LibrarySearchKeyDown" AutomationProperties.Name="Buscar en biblioteca" MinHeight="42" FontSize="17"/>
                </StackPanel>
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="Limpiar" Click="ClearLibrarySearchClick" VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="9,8" MinHeight="42" AutomationProperties.Name="Limpiar búsqueda"/>
              </Grid>
              <ListBox x:Name="LibraryFilter" Grid.Row="1" SelectedIndex="0" SelectionChanged="LibraryFilterChanged" ItemContainerStyle="{StaticResource FilterChip}" Margin="0,10,0,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Categoría de la biblioteca">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem Content="Todo"/><ListBoxItem Content="Himnos"/><ListBoxItem Content="Videos"/><ListBoxItem Content="Imágenes"/><ListBoxItem Content="Audio"/><ListBoxItem Content="Textos"/>
              </ListBox>
              <TextBlock x:Name="LibraryCountText" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,8"/>
              <Grid Grid.Row="3">
                <ListBox x:Name="LibraryList" ItemTemplate="{StaticResource LibraryItemTemplate}" SelectionChanged="LibrarySelectionChanged" AutomationProperties.Name="Biblioteca de contenidos"/>
                <TextBlock x:Name="LibraryEmpty" Text="Biblioteca vacía" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="18,30" TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="+ Añadir al orden" Click="AddLibraryToPlanClick" Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource SelectedBrush}" MinHeight="40"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Biblia">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="BibleNameText" Text="Biblia" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="BibleStatusText" Text="Sin Biblia cargada" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Libro" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleBookPicker" SelectionChanged="BibleBookChanged" MaxDropDownHeight="360" IsTextSearchEnabled="True" AutomationProperties.Name="Libro de la Biblia"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Capítulo" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleChapterPicker" SelectionChanged="BibleChapterChanged" MaxDropDownHeight="300" AutomationProperties.Name="Capítulo de la Biblia"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Versículo" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleVersePicker" SelectionChanged="BibleVerseChanged" MaxDropDownHeight="300" AutomationProperties.Name="Versículo de la Biblia"/></StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Cita o frase" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="BibleQuery" KeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia" FontSize="16" MinHeight="40"/>
                  <Button Grid.Column="1" Content="Buscar" Click="SearchBibleClick" Margin="6,0,0,0"/>
                </Grid>
              </StackPanel>
              <TextBlock Grid.Row="3" x:Name="BibleResultText" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
              <ListBox Grid.Row="4" x:Name="BibleResults" SelectionChanged="BibleSelectionChanged" AutomationProperties.Name="Resultados de Biblia">
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                  <TextBlock Text="{Binding Reference}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="AddSelectedBibleButton" Content="+ Versículo al orden" Click="AddSelectedBibleToPlanClick" MinHeight="40"/>
                <Button Grid.Column="1" x:Name="AddBiblePassageButton" Content="Pasaje" Click="AddBibleToPlanClick" Visibility="Collapsed" Margin="8,0,0,0" MinHeight="40"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Texto">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Título" Style="{StaticResource MutedText}"/>
                <TextBox x:Name="TextTitleBox" Text="Bienvenidos" Margin="0,6,0,12" AutomationProperties.Name="Título del texto"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Mensaje para la congregación" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Grid.Row="2" x:Name="TextBodyBox" Text="Nos alegra compartir este culto contigo." AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="17" AutomationProperties.Name="Texto para proyectar"/>
              <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Button Content="Preparar texto" Click="PrepareTextClick" MinHeight="40"/>
                <Button Content="+ Guardar en biblioteca y orden" Click="SaveTextClick" Margin="0,6,0,0" MinHeight="40"/>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" AutomationProperties.Name="Ancho de vista previa"/>

      <Grid Grid.Column="4">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="12" BorderBrush="{StaticResource PanelBorderBrush}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <TextBlock Text="Vista previa" Foreground="{StaticResource AmberBrush}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="SIN SONIDO" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" Background="#050505" CornerRadius="8" ClipToBounds="True"><ContentControl x:Name="PreviewHost" MinHeight="80"/></Border>
            <Grid Grid.Row="2" Margin="0,8,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PreparedTitleText" Text="Sin contenido" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,6,0"/>
            </Grid>
            <Grid Grid.Row="3" x:Name="PreviewPlaybackPanel" Visibility="Collapsed" Margin="0,0,0,8">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="PreviewPauseButton" Content="Pausar previa" Click="PreviewPauseClick" Padding="7,5" MinHeight="30" FontSize="11"/>
                <Button x:Name="PreviewRestartButton" Grid.Column="1" Content="Reiniciar" Click="PreviewRestartClick" Margin="6,0,0,0" Padding="7,5" MinHeight="30" FontSize="11" AutomationProperties.Name="Reiniciar vista previa"/>
                <TextBlock x:Name="PreviewTimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </Grid>
              <Slider x:Name="PreviewPositionSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True" Margin="0,7,0,0" PreviewMouseLeftButtonUp="PreviewPositionSeek" PreviewKeyUp="PreviewPositionKeyUp" AutomationProperties.Name="Avance de la vista previa"/>
            </Grid>
            <Button x:Name="ProjectButton" Grid.Row="4" Style="{StaticResource PrimaryButton}" Click="ProjectClick" MinHeight="44" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Proyectar contenido preparado">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Proyectar a pantalla" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="F5" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" BorderBrush="{StaticResource PanelBorderBrush}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="En pantalla" Foreground="{StaticResource LiveBrush}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" x:Name="OutputModeText" Text="SIN SALIDA" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=OutputStatusText}"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
              <TextBlock x:Name="LiveTitleText" Text="Sin contenido" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="LiveBodyText" Text="La salida está cerrada." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=MediaPlaybackPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock x:Name="LiveReferenceText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
              <TextBlock x:Name="OutputStatusText" Text="Una salida HDMI · tres pantallas iguales" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock Grid.Row="2" x:Name="NextLiveText" Text="Sin contenido en salida" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,6" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Grid Grid.Row="3" x:Name="ScreenNavigationPanel">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="Anterior" Click="PreviousClick" Margin="0,0,4,0" MinHeight="36" Padding="3,6" FontSize="12"/>
              <Button Grid.Column="1" Content="Siguiente" Click="NextClick" Margin="0,0,4,0" MinHeight="36" Padding="3,6" FontSize="12"/>
              <Button Grid.Column="2" x:Name="BlackoutButton" Content="Negro" Click="BlackoutClick" Margin="0,0,4,0" MinHeight="36" Padding="3,6" FontSize="12"/>
              <Button Grid.Column="3" Content="Fondo" Click="BackgroundClick" MinHeight="36" Padding="3,6" FontSize="12"/>
            </Grid>
            <Grid Grid.Row="4" x:Name="MediaPlaybackPanel" Visibility="Collapsed" Margin="0,8,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="PauseButton" Content="Pausar" Click="PauseClick" Padding="10,5" MinHeight="30" FontSize="12"/>
                <Button Grid.Column="1" Content="Reiniciar" Click="RestartClick" Padding="10,5" MinHeight="30" FontSize="12" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/>
              </Grid>
              <Slider Grid.Row="1" x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,8" PreviewMouseLeftButtonUp="PositionSeek" AutomationProperties.Name="Posición del video"/>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="VolumeText" Text="80 %" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" MinWidth="34"/>
                <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" Margin="6,0,10,0" AutomationProperties.Name="Volumen de la proyección"/>
                <CheckBox Grid.Column="2" x:Name="LoopCheck" Content="Repetir" Checked="LoopChanged" Unchecked="LoopChanged" FontSize="11" MinHeight="24"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
