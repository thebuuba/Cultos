<Window x:Class="Culto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Culto.Desktop"
        Title="Culto Studio — Consola de iglesia" Width="1480" Height="900"
        MinWidth="1180" MinHeight="680" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <local:OrderNumberConverter x:Key="OrderNumberConverter"/>
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent">
              <Border x:Name="Grip" Background="{StaticResource BorderBrush}" Width="2" Height="42" CornerRadius="1" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AmberBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource CanvasBrush}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="#203D3D"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="OrderItemTemplate">
      <Grid ToolTip="{Binding Title}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="26" Height="28" CornerRadius="5" Background="{StaticResource CanvasBrush}" VerticalAlignment="Top">
          <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10"
                     Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LibraryItemTemplate">
      <Grid ToolTip="{Binding Title}" MinHeight="30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
          <Path x:Name="KindIcon" Data="M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,7 L 13,7 M 7,10 L 13,10 M 7,13 L 11,13"
                Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" Width="15" Height="17" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Video">
          <Setter TargetName="KindIcon" Property="Data" Value="M 5,3 L 17,10 L 5,17 Z"/>
          <Setter TargetName="KindIcon" Property="Stroke" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Audio">
          <Setter TargetName="KindIcon" Property="Data" Value="M 8,14 L 8,4 L 17,2 L 17,12 M 8,14 C 8,18 1,18 1,15 C 1,12 8,12 8,14 M 17,12 C 17,16 10,16 10,13 C 10,10 17,10 17,12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image">
          <Setter TargetName="KindIcon" Property="Data" Value="M 2,3 L 18,3 L 18,17 L 2,17 Z M 2,14 L 8,8 L 13,13 L 16,10 L 18,12"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20,16,20,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/>
      <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
          <Path Data="M 3,4 L 10,2 L 17,4 L 17,17 L 10,15 L 3,17 Z M 10,2 L 10,15"
                Stroke="#0C2621" StrokeThickness="1.7" Width="21" Height="22" Stretch="Uniform"/>
        </Border>
        <StackPanel>
          <TextBlock Text="Culto Studio" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="CONSOLA DE CULTO" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="16,0,20,0" MaxWidth="400">
        <TextBlock Text="CULTO ACTUAL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="PlanNameBox" Text="Culto del sábado" FontSize="16" FontWeight="SemiBold"
                 LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Nuevo" Click="NewPlanClick" Margin="0,0,6,0" ToolTip="Crear un orden y archivar el anterior"/>
        <Button Content="Abrir" Click="OpenPlanClick" Margin="0,0,6,0"/>
        <Button Content="Guardar" Click="SavePlanClick" Margin="0,0,16,0" ToolTip="Guardar una copia del orden · Ctrl+S"/>
        <Button Content="Pantalla" Click="DisplayClick" Margin="0,0,6,0"/>
        <Button x:Name="RemoteButton" Content="Mando móvil" Click="RemoteClick"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.35*" MinWidth="230" MaxWidth="390"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="0.44*" MinWidth="310" MaxWidth="460"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="2,0,2,6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Orden del culto" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" CornerRadius="6" Background="{StaticResource RaisedBrush}" Padding="9,5">
              <TextBlock x:Name="PlanCountText" Text="0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" Text="Selecciona y prepara el siguiente momento." Style="{StaticResource MutedText}" Margin="2,0,2,12"/>
          <Grid Grid.Row="2">
            <local:OrderListBox x:Name="PlanList" ItemTemplate="{StaticResource OrderItemTemplate}" Style="{StaticResource {x:Type ListBox}}"
                     SelectionChanged="PlanSelectionChanged" AllowDrop="True"
                     PreviewMouseLeftButtonDown="PlanMouseDown" MouseMove="PlanMouseMove" Drop="PlanDrop"
                     AutomationProperties.Name="Orden de culto"/>
            <TextBlock x:Name="PlanEmptyText" Text="Comienza tu culto&#10;&#10;Elige un contenido y pulsa Añadir al orden."
                       Style="{StaticResource MutedText}" Margin="12,24" TextAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
          <Grid Grid.Row="3" Margin="0,10,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Content="↑ Subir" Click="MoveUpClick" Padding="6,7" MinHeight="34" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="↓ Bajar" Click="MoveDownClick" Padding="6,7" MinHeight="34" Margin="0,0,4,0"/>
            <Button Grid.Column="2" Content="Quitar" Click="RemoveCueClick" Padding="6,7" MinHeight="34"/>
          </Grid>
          <StackPanel Grid.Row="4">
            <TextBlock Text="Notas privadas" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,6"/>
            <TextBox x:Name="NotesBox" Height="62" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     LostFocus="NotesChanged" AutomationProperties.Name="Notas privadas del elemento"
                     ToolTip="Estas notas solo las ve el operador."/>
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True" ToolTip="Ajustar el ancho del orden" AutomationProperties.Name="Ancho del orden de culto"/>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12,16,14">
        <TabControl x:Name="ContentTabs">
          <TabItem Header="Biblioteca">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Buscar título o número de himno" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                  <TextBox x:Name="LibrarySearch" TextChanged="LibrarySearchChanged" AutomationProperties.Name="Buscar en biblioteca" MinHeight="40"/>
                </StackPanel>
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="Limpiar" Click="ClearLibrarySearchClick"
                        VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="9,8" MinHeight="40"
                        ToolTip="Borrar la búsqueda y conservar la categoría" AutomationProperties.Name="Limpiar búsqueda"/>
              </Grid>
              <ListBox x:Name="LibraryFilter" Grid.Row="1" SelectedIndex="0" SelectionChanged="LibraryFilterChanged"
                       ItemContainerStyle="{StaticResource FilterChip}" Margin="0,12,0,2"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Categoría de la biblioteca">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem Content="Todo"/><ListBoxItem Content="Himnos"/><ListBoxItem Content="Videos"/>
                <ListBoxItem Content="Imágenes"/><ListBoxItem Content="Audio"/><ListBoxItem Content="Textos"/>
              </ListBox>
              <TextBlock x:Name="LibraryCountText" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,8"/>
              <Grid Grid.Row="3">
                <ListBox x:Name="LibraryList" ItemTemplate="{StaticResource LibraryItemTemplate}"
                         SelectionChanged="LibrarySelectionChanged" AutomationProperties.Name="Biblioteca de contenidos"/>
                <TextBlock x:Name="LibraryEmpty" Text="Importa los videos del himnario para comenzar."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="18,30"
                           TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <WrapPanel Grid.Row="4" Margin="0,10,0,2">
                <Button Content="+ Archivos" Click="ImportFilesClick" Margin="0,0,6,6" MinHeight="34" Padding="10,7" ToolTip="Importar videos, imágenes o audio"/>
                <Button Content="Carpeta de himnos" Click="ImportFolderClick" Margin="0,0,6,6" MinHeight="34" Padding="10,7"/>
                <Button Content="Captura" Click="CaptureClick" Margin="0,0,0,6" MinHeight="34" Padding="10,7"/>
              </WrapPanel>
              <Grid Grid.Row="5">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="+ Añadir al orden" Click="AddLibraryToPlanClick" MinHeight="40"/>
                <Button Grid.Column="1" Content="Editar" Click="EditLibraryClick" Margin="6,0,0,0" MinHeight="40"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Biblia">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                  <TextBlock x:Name="BibleNameText" Text="Reina-Valera 1960" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BibleStatusText" Text="Importa una copia autorizada para consultar sin internet." Style="{StaticResource MutedText}" Margin="0,5,0,8"/>
                  <Button Content="Importar Biblia · JSON o XML" Click="ImportBibleClick" HorizontalAlignment="Left" MinHeight="34" Padding="10,7"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Row="1" Margin="0,12,0,8">
                <TextBlock Text="Cita o palabras · ejemplo: Juan 3:16-18" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="BibleQuery" KeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia"/>
                  <Button Grid.Column="1" Content="Buscar" Click="SearchBibleClick" Margin="6,0,0,0"/>
                </Grid>
              </StackPanel>
              <TextBlock Grid.Row="2" x:Name="BibleResultText" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
              <ListBox Grid.Row="3" x:Name="BibleResults" SelectionChanged="BibleSelectionChanged" AutomationProperties.Name="Resultados de Biblia">
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                  <TextBlock Text="{Binding Reference}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="4" Content="+ Añadir lectura al orden" Click="AddBibleToPlanClick" Margin="0,10,0,0" MinHeight="40"/>
            </Grid>
          </TabItem>
          <TabItem Header="Texto">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Título del contenido" Style="{StaticResource MutedText}"/>
                <TextBox x:Name="TextTitleBox" Text="Bienvenidos" Margin="0,6,0,12" AutomationProperties.Name="Título del texto"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Texto que verá la congregación" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Grid.Row="2" x:Name="TextBodyBox" Text="Nos alegra compartir este culto contigo."
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" FontSize="17" AutomationProperties.Name="Texto para proyectar"/>
              <TextBlock Grid.Row="3" Text="Bienvenidas, anuncios o letras. Revísalo en la vista previa antes de proyectar."
                         Style="{StaticResource MutedText}" Margin="0,12,0,12"/>
              <StackPanel Grid.Row="4">
                <Button Content="Preparar texto" Click="PrepareTextClick" MinHeight="40"/>
                <Button Content="+ Guardar en biblioteca y orden" Click="SaveTextClick" Margin="0,6,0,0" MinHeight="40"/>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True" ToolTip="Ajustar el ancho de la vista previa" AutomationProperties.Name="Ancho de vista previa"/>

      <Grid Grid.Column="4">
        <Grid.RowDefinitions><RowDefinition Height="1.3*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14" BorderBrush="#65583C">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <TextBlock Text="PREPARADO" Foreground="{StaticResource AmberBrush}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="SIN SONIDO" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <Border Grid.Row="1" Background="#080D14" CornerRadius="6" ClipToBounds="True">
              <ContentControl x:Name="PreviewHost" MinHeight="80"/>
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PreparedTitleText" Text="Selecciona un contenido" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,6,0"/>
              <Button x:Name="PreviewPauseButton" Grid.Column="1" Content="Pausar previa" Click="PreviewPauseClick" Padding="7,5" MinHeight="30" FontSize="11"/>
            </Grid>
            <Button x:Name="ProjectButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Click="ProjectClick"
                    MinHeight="42" HorizontalContentAlignment="Stretch" ToolTip="Enviar el contenido preparado a la pantalla · F5"
                    AutomationProperties.Name="Proyectar contenido preparado">
              <Grid MinWidth="235">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path Data="M 0,0 L 9,6 L 0,12 Z" Fill="#09251F" Width="9" Height="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Proyectar" FontSize="15" FontWeight="SemiBold" Margin="10,0"/>
                <TextBlock Grid.Column="2" Text="F5" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" BorderBrush="#315B55">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="EN PANTALLA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource CanvasBrush}" CornerRadius="4" Padding="6,4">
                <TextBlock x:Name="OutputModeText" Text="SIN SALIDA" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
              </Border>
            </Grid>
            <Border Grid.Row="1" Margin="0,10,0,10" Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="12" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="LiveBodyText" Text="La salida está cerrada." TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="15" MaxHeight="110" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" x:Name="LiveReferenceText" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,6,0,0"/>
              </Grid>
            </Border>
            <TextBlock Grid.Row="2" x:Name="LiveTitleText" Text="Listo cuando tú lo estés" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock Grid.Row="3" x:Name="OutputStatusText" Text="Una salida HDMI · tres pantallas iguales"
                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CONTROL DE LA PANTALLA" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="← Anterior" Click="PreviousClick" ToolTip="Anterior en vivo · F7" Margin="0,0,6,0"/>
            <Button Content="Siguiente →" Click="NextClick" ToolTip="Siguiente en vivo · F6" Margin="0,0,16,0"/>
            <Button x:Name="BlackoutButton" Content="Negro" Click="BlackoutClick" ToolTip="Pantalla negra / restaurar · F8" Margin="0,0,6,0" MinWidth="85"/>
            <Button Content="Fondo" Click="BackgroundClick" ToolTip="Ocultar el contenido y pausar la reproducción"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" Content="Pausar" Click="PauseClick" Padding="10,5" MinHeight="30" FontSize="12"/>
            <Button Grid.Column="1" Content="Reiniciar" Click="RestartClick" Padding="10,5" MinHeight="30" FontSize="12" Margin="6,0,0,0"/>
            <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
          </Grid>
          <Slider Grid.Row="1" x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,0"
                  PreviewMouseLeftButtonUp="PositionSeek" AutomationProperties.Name="Posición del video"/>
        </Grid>
        <StackPanel Grid.Column="4">
          <Grid>
            <TextBlock Text="VOLUMEN" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="VolumeText" Text="80 %" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          </Grid>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" Margin="0,5,0,0" AutomationProperties.Name="Volumen de la proyección"/>
          <CheckBox x:Name="LoopCheck" Content="Repetir video" Checked="LoopChanged" Unchecked="LoopChanged" FontSize="11" MinHeight="22"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="5" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Todo listo para preparar tu culto." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="1" Text="TRABAJA SIN INTERNET" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,0,0"/>
    </Grid>
  </Grid>
</Window>
