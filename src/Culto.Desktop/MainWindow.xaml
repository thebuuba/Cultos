<Window x:Class="Culto.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Culto Studio — Consola de iglesia" Width="1440" Height="920" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="22,18,22,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="C" Foreground="#09251F" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Culto Studio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="PREPARAR. PROYECTAR. ACOMPAÑAR." FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Margin="16,0,18,0" MaxWidth="390" HorizontalAlignment="Left"><TextBlock Text="ORDEN ACTUAL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3"/><TextBox x:Name="PlanNameBox" Text="Culto del sábado" FontSize="16" FontWeight="SemiBold" MinWidth="230" LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Nuevo" Click="NewPlanClick" Margin="0,0,6,0"/><Button Content="Abrir" Click="OpenPlanClick" Margin="0,0,6,0"/><Button Content="Guardar" Click="SavePlanClick" Margin="0,0,12,0"/><Button Content="Pantalla" Click="DisplayClick" Margin="0,0,6,0"/><Button x:Name="RemoteButton" Content="Mando móvil" Click="RemoteClick"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="345"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12,16,12,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,8"><TextBlock Text="ORDEN DE CULTO" Style="{StaticResource Overline}"/><TextBlock x:Name="PlanCountText" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></Grid>
        <TextBlock Grid.Row="1" Text="Selecciona para preparar; proyecta cuando estés listo." Style="{StaticResource MutedText}" Margin="4,0,4,12"/>
        <ListBox x:Name="PlanList" Grid.Row="2" ItemTemplate="{StaticResource CueTemplate}" SelectionChanged="PlanSelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="PlanMouseDown" MouseMove="PlanMouseMove" Drop="PlanDrop" AutomationProperties.Name="Orden de culto"/>
        <Grid Grid.Row="3" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Subir" Click="MoveUpClick" Padding="6,7" Margin="0,0,5,0"/><Button Grid.Column="1" Content="Bajar" Click="MoveDownClick" Padding="6,7" Margin="0,0,5,0"/><Button Grid.Column="2" Content="Quitar" Click="RemoveCueClick" Padding="8,7"/></Grid>
        <TextBlock Grid.Row="4" Text="NOTAS PRIVADAS" Style="{StaticResource Overline}" Margin="4,0,0,6"/>
        <TextBox Grid.Row="5" x:Name="NotesBox" MinHeight="70" MaxHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="NotesChanged" AutomationProperties.Name="Notas privadas del elemento"/>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CONTENIDO DEL CULTO" Style="{StaticResource Overline}"/>
      <TabControl Grid.Row="1" x:Name="ContentTabs">
        <TabItem Header="Biblioteca"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Buscar título o número de himno" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="LibrarySearch" TextChanged="LibrarySearchChanged" AutomationProperties.Name="Buscar en biblioteca"/><ComboBox x:Name="LibraryFilter" SelectedIndex="0" SelectionChanged="LibraryFilterChanged" Margin="0,8,0,0"><ComboBoxItem Content="Todo el contenido"/><ComboBoxItem Content="Himnos numerados"/><ComboBoxItem Content="Videos"/><ComboBoxItem Content="Imágenes"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Textos"/></ComboBox></StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,12,0,8"><Button Content="Importar archivos" Click="ImportFilesClick" Margin="0,0,6,6"/><Button Content="Carpeta de himnos" Click="ImportFolderClick" Margin="0,0,6,6"/><Button Content="Captura" Click="CaptureClick" Margin="0,0,0,6"/></WrapPanel>
          <Grid Grid.Row="2"><ListBox x:Name="LibraryList" ItemTemplate="{StaticResource CueTemplate}" SelectionChanged="LibrarySelectionChanged" AutomationProperties.Name="Biblioteca de contenidos"/><TextBlock x:Name="LibraryEmpty" Text="Tu biblioteca, en un solo lugar.&#10;&#10;Importa los videos MKV del himnario, imágenes o pistas de audio para comenzar." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="16,30" IsHitTestVisible="False"/></Grid>
          <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Añadir al orden" Click="AddLibraryToPlanClick" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="1" Content="Editar" Click="EditLibraryClick" Margin="8,0,0,0"/></Grid>
        </Grid></TabItem>
        <TabItem Header="Biblia"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#152C30" CornerRadius="6" Padding="12"><StackPanel><TextBlock x:Name="BibleNameText" Text="Reina-Valera 1960" FontWeight="SemiBold"/><TextBlock x:Name="BibleStatusText" Text="Importa una copia autorizada para consultar sin internet." Style="{StaticResource MutedText}" Margin="0,5,0,8"/><Button Content="Importar Biblia · JSON o XML" Click="ImportBibleClick" HorizontalAlignment="Left"/></StackPanel></Border>
          <StackPanel Grid.Row="1" Margin="0,14,0,8"><TextBlock Text="Cita o palabras · ejemplo: Juan 3:16-18" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BibleQuery" KeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia"/><Button Grid.Column="1" Content="Buscar" Click="SearchBibleClick" Margin="7,0,0,0"/></Grid></StackPanel>
          <TextBlock Grid.Row="2" x:Name="BibleResultText" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="3" x:Name="BibleResults" SelectionChanged="BibleSelectionChanged" AutomationProperties.Name="Resultados de Biblia"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Reference}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Button Grid.Row="4" Content="Añadir lectura al orden" Click="AddBibleToPlanClick" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
        </Grid></TabItem>
        <TabItem Header="Texto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Título" Style="{StaticResource MutedText}"/><TextBox x:Name="TextTitleBox" Text="Bienvenidos" Margin="0,5,0,12" AutomationProperties.Name="Título del texto"/></StackPanel>
          <TextBlock Grid.Row="1" Text="Texto que verá la congregación" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
          <TextBox Grid.Row="2" x:Name="TextBodyBox" Text="Nos alegra compartir este culto contigo." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" MaxHeight="270" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="17" AutomationProperties.Name="Texto para proyectar"/>
          <TextBlock Grid.Row="3" Text="Puedes escribir una bienvenida, un anuncio o la letra de una canción. Las notas del orden permanecen privadas." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
          <StackPanel Grid.Row="4"><Button Content="Preparar texto" Click="PrepareTextClick" Style="{StaticResource PrimaryButton}"/><Button Content="Guardar en biblioteca y orden" Click="SaveTextClick" Margin="0,8,0,0"/></StackPanel>
        </Grid></TabItem>
      </TabControl></Grid></Border>
      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PREPARADO" Foreground="{StaticResource AmberBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/><Border Grid.Row="1" Background="#090F18" CornerRadius="5" ClipToBounds="True"><ContentControl x:Name="PreviewHost" MinHeight="150"/></Border><TextBlock Grid.Row="2" x:Name="PreparedTitleText" Text="Selecciona un contenido" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Vista previa sin sonido" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Pausar previa" Click="PreviewPauseClick" Padding="8,6" MinHeight="30"/></Grid></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="EN PANTALLA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="OutputModeText" Text="SIN SALIDA" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><Border Grid.Row="1" Margin="0,12,0,12" Background="#0A1421" CornerRadius="5" Padding="14"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="LiveBodyText" Text="La salida está cerrada." TextAlignment="Center" TextWrapping="Wrap" FontSize="17" MaxHeight="150" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LiveReferenceText" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Grid.Row="2" x:Name="LiveTitleText" Text="Listo cuando tú lo estés" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Row="3" x:Name="OutputStatusText" Text="Una salida HDMI · tres pantallas iguales" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></Grid></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <Button Content="Proyectar   F5" Style="{StaticResource PrimaryButton}" Click="ProjectClick" FontSize="16" MinWidth="160" MinHeight="46" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Anterior" Click="PreviousClick" Margin="0,0,6,0"/><Button Content="Siguiente" Click="NextClick" Margin="0,0,12,0"/><Button x:Name="BlackoutButton" Content="Negro" Click="BlackoutClick" Margin="0,0,6,0"/><Button Content="Fondo" Click="BackgroundClick"/></StackPanel>
      <Grid Grid.Column="3" Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="PauseButton" Content="Pausar" Click="PauseClick" Padding="9,4" MinHeight="28"/><Button Content="Reiniciar" Click="RestartClick" Padding="9,4" MinHeight="28" Margin="6,0,10,0"/><TextBlock x:Name="TimeText" Text="00:00 / 00:00" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Slider Grid.Row="1" x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" Margin="0,5,0,0" PreviewMouseLeftButtonUp="PositionSeek" AutomationProperties.Name="Posición del video"/></Grid>
      <StackPanel Grid.Column="4"><Grid><TextBlock Text="VOLUMEN" Style="{StaticResource MutedText}"/><TextBlock x:Name="VolumeText" Text="80 %" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/></Grid><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" Margin="0,3,0,0" AutomationProperties.Name="Volumen de la proyección"/><CheckBox x:Name="LoopCheck" Content="Repetir video" Checked="LoopChanged" Unchecked="LoopChanged" FontSize="11" MinHeight="20"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="5" Margin="2,9,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Todo listo. Importa contenido o prepara un texto para comenzar." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="LOCAL · SIN DEPENDENCIA DE INTERNET" Foreground="#8295AC" FontSize="10" Margin="12,0,0,0"/></Grid>
  </Grid>
</Window>
