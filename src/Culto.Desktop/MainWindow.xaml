<ad:LayoutAnchorable Title="PowerPoint" ContentId="powerpoint" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
  <Border x:Name="PowerPointPanel" Background="{StaticResource PanelBrush}" Padding="{StaticResource SourcePanelPadding}" AllowDrop="True" DragOver="PowerPointFilesDragOver" Drop="PowerPointFilesDrop">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*" MinHeight="72"/><RowDefinition Height="Auto"/><RowDefinition Height="1.4*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="+ Agregar" Click="ImportPowerPointClick" MinHeight="30" Padding="12,4" AutomationProperties.Name="Agregar presentaciones de PowerPoint"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Presentaciones" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PowerPointFileCountText" Text="Arrastra un .pptx para agregar" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,8,0"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <TextBox x:Name="PowerPointSearch" TextChanged="PowerPointSearchChanged" MinHeight="32" Padding="12,6" AutomationProperties.Name="Buscar presentación"/>
        <TextBlock Text="Buscar presentación…" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center" FontSize="12">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=PowerPointSearch}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <Grid Grid.Row="2">
        <ListBox x:Name="PowerPointFiles" SelectionChanged="PowerPointSelectionChanged" MouseDoubleClick="PowerPointDoubleClick" PreviewKeyDown="PowerPointKeyDown" AutomationProperties.Name="Presentaciones de PowerPoint" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Grid DataContext="{Binding Converter={StaticResource PowerPointMetadataConverter}}" ToolTip="{Binding FileName}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
            <Border Width="60" Height="38" CornerRadius="6" Background="{StaticResource RaisedBrush}" ClipToBounds="True"><Grid><TextBlock Text="PPT" FontSize="11" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,5,0"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Button Grid.Column="2" Content="⋯" Click="PowerPointFileMenuClick" MinHeight="28" Padding="3" Background="Transparent" BorderBrush="Transparent" ToolTip="Opciones de la presentación" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
              <Button.ContextMenu><ContextMenu><MenuItem Header="Renombrar" Click="RenamePowerPointFileClick" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Quitar de la lista" Click="RemovePowerPointFileClick" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Button.ContextMenu>
            </Button>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PowerPointEmpty" Text="Agrega o arrastra una presentación de PowerPoint." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="10" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,10,0,5">
        <DockPanel><Button DockPanel.Dock="Right" Content="↻" Click="RefreshPowerPointPreviewsClick" MinHeight="24" Width="26" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Actualizar miniaturas"/><TextBlock Text="DIAPOSITIVAS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock x:Name="PowerPointSlideHint" Text="Selecciona una presentación" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
      <ListBox x:Name="PowerPointSlides" Grid.Row="4" SelectionChanged="PowerPointSlideSelected" AutomationProperties.Name="Diapositivas de la presentación" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Width" Value="125"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
          <Border Height="66" Background="#101010" CornerRadius="5" ClipToBounds="True"><Grid><Image Source="{Binding Image}" Stretch="Uniform"/><Border Background="#D0191919" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="3" Margin="3" Padding="5,1"><TextBlock Text="{Binding Number}" Foreground="White" FontSize="10"/></Border></Grid></Border>
          <TextBlock Text="{Binding Title}" FontSize="10" Margin="1,4,1,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="5" Margin="0,8,0,0">
        <TextBlock x:Name="PowerPointLiveText" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <WrapPanel x:Name="PowerPointPlaybackPanel" Margin="0,5,0,5" VerticalAlignment="Center">
          <Button x:Name="PowerPointRestartButton" Content="&#xE72C;" Click="PowerPointRestartClick" Style="{StaticResource PlayerButton}" ToolTip="Volver al inicio" AutomationProperties.Name="Reiniciar PowerPoint"/>
          <Button x:Name="PowerPointPreviousButton" Content="&#xE76B;" Click="PowerPointPreviousClick" Style="{StaticResource PlayerButton}" ToolTip="Anterior · Diapositiva o animación" AutomationProperties.Name="Anterior en PowerPoint"/>
          <TextBlock x:Name="PowerPointPositionText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0"/>
          <Button x:Name="PowerPointNextButton" Content="&#xE76C;" Click="PowerPointNextClick" Style="{StaticResource PlayerButton}" ToolTip="Siguiente · Diapositiva o animación" AutomationProperties.Name="Siguiente en PowerPoint"/>
          <Button x:Name="PowerPointPauseButton" Content="Pausar" Click="PowerPointPauseClick" MinHeight="30" Padding="5,3" FontSize="11" Background="Transparent" BorderBrush="Transparent"/>
          <!-- Lucide monitor-off / monitor, ISC/MIT: Assets/Licenses/lucide.txt. -->
          <Button x:Name="PowerPointBlackoutButton" Click="PowerPointBlackoutClick" Style="{StaticResource PlayerButton}" ToolTip="Pantalla en negro" AutomationProperties.Name="Pantalla en negro de PowerPoint">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
              <Path Data="M17 17H4 A2 2 0 0 1 2 15 V5 C2 3.5 3 3 3 3 M22 15V5 A2 2 0 0 0 20 3 H9 M8 21H16 M12 17V21 M2 2L22 22"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas></Viewbox>
          </Button>
          <Button x:Name="PowerPointModeratorButton" Style="{StaticResource PlayerButton}" Click="OpenPowerPointModeratorClick" ToolTip="Vista de moderador · Actual, siguiente y notas" AutomationProperties.Name="Abrir vista de moderador">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
              <Path Data="M4 3H20 A2 2 0 0 1 22 5 V15 A2 2 0 0 1 20 17 H4 A2 2 0 0 1 2 15 V5 A2 2 0 0 1 4 3 Z M8 21H16 M12 17V21"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas></Viewbox>
          </Button>
        </WrapPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="PowerPointProjectButton" Content="Proyectar" Click="ProjectPowerPointClick" Background="{StaticResource ActionBrush}" Foreground="{StaticResource OnActionBrush}" MinHeight="34" Padding="12,5"/>
          <Button x:Name="PowerPointAddToPlanButton" Grid.Column="1" Content="+ Al orden" Click="AddPowerPointToPlanClick" MinHeight="34" Padding="8,5" Background="Transparent" BorderBrush="Transparent" Margin="5,0,0,0"/>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="6" Margin="0,8,0,0">
        <ToggleButton x:Name="PowerPointUsbOptions" HorizontalAlignment="Left" AutomationProperties.Name="Opciones del presentador USB" Padding="7,5" Foreground="{StaticResource MutedBrush}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="UsbTrigger" Background="{StaticResource RaisedBrush}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="local:KeyboardFocusCue.IsVisible" Value="True"><Setter TargetName="UsbTrigger" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="UsbTrigger" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          <StackPanel Orientation="Horizontal">
            <Border Background="#29413B1B" CornerRadius="9" Width="20" Height="20" Margin="0,0,6,0"><Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M11 7A1 1 0 1 1 9 7A1 1 0 1 1 11 7 M5 20A1 1 0 1 1 3 20A1 1 0 1 1 5 20 M4.7 19.3L19 5 M21 3L18 4L20 6Z M9.26 7.68L5 12L7 17 M10 14L15 16L18.5 12.5 M18 12L19 11L20 12L19 13Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border>
            <TextBlock x:Name="PowerPointUsbSummary" Text="Presentador USB · Apagado" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
            <Path Data="M0 4L4 0L8 4" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" VerticalAlignment="Center" Margin="9,0,0,0"/>
          </StackPanel>
        </ToggleButton>
        <Popup x:Name="PowerPointUsbPopup" Placement="Top" PlacementTarget="{Binding ElementName=PowerPointUsbOptions}" IsOpen="{Binding IsChecked, ElementName=PowerPointUsbOptions, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6" Opened="PowerPointUsbPopupOpened">
          <Border Width="294" Background="White" BorderBrush="#DDDDDF" BorderThickness="1" CornerRadius="12" Padding="16" TextElement.Foreground="#24272C" PreviewKeyDown="PowerPointUsbPopupKeyDown">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Controlar con presentador USB" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                <CheckBox x:Name="PowerPointUsbCheck" Grid.Column="1" Click="TogglePresenterClick" Style="{StaticResource ServiceSwitch}" AutomationProperties.Name="Controlar con presentador USB" Margin="8,0,0,0"/>
              </Grid>
              <TextBlock Text="Avanza o retrocede diapositivas&#x0a;aunque otra ventana esté activa." Foreground="#70747D" FontSize="11" LineHeight="20" Margin="0,7,0,12"/>
              <Border BorderBrush="#E5E5E7" BorderThickness="0,1,0,0" Margin="-16,0,-16,12"/>
              <TextBlock Text="Teclas del control" Foreground="#70747D" FontSize="11" FontWeight="Medium" Margin="0,0,0,7"/>
              <ComboBox x:Name="PowerPointUsbKeys" SelectionChanged="PowerPointUsbKeysChanged" AutomationProperties.Name="Teclas del presentador USB" MinHeight="36" Background="White" Foreground="#24272C" BorderBrush="#DADADD" FontSize="12">
                <ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid>
                  <Border x:Name="UsbKeyFrame" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"/>
                  <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
                  <ContentPresenter Margin="10,0,30,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="#24272C" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <Path Data="M0 3L3 0L6 3 M0 7L3 10L6 7" Stroke="#8C8F96" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                  <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"><Border Background="White" BorderBrush="#DADADD" BorderThickness="1" CornerRadius="9" MinWidth="{TemplateBinding ActualWidth}" Padding="3"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
                </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="UsbKeyFrame" Property="BorderBrush" Value="#84C318"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ComboBox.Template>
                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#24272C"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#EFF5E7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Av Pág / Re Pág"/><ComboBoxItem Content="Flechas derecha / izquierda"/>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse x:Name="PowerPointUsbIndicator" Width="6" Height="6" Fill="#84C318" Margin="0,0,6,0"/><TextBlock x:Name="PowerPointUsbStatus" Foreground="#70747D" FontSize="10" Text="Desactivado"/></StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Grid>
  </Border>

</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="Biblia" ContentId="bible" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="BiblePanel" Background="{StaticResource PanelBrush}" CornerRadius="0" Padding="{StaticResource SourcePanelPadding}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="BibleNameText" Text="Biblia" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="+" Style="{StaticResource CompactIconButton}" ToolTip="Agregar versiones de la Biblia" Click="ImportBibleClick" AutomationProperties.Name="Agregar versiones de la Biblia"/>
                  <Button Content="⋯" Style="{StaticResource CompactIconButton}" ToolTip="Estilo de la Biblia" Click="BibleStyleClick" AutomationProperties.Name="Editar estilo de la Biblia"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="BibleBookPicker" Margin="0,0,5,0" Padding="10,5,28,5" MinHeight="32" FontSize="12" SelectionChanged="BibleBookChanged" PreviewKeyDown="BibleBookKeyDown" LostKeyboardFocus="BibleBookLostFocus" MaxDropDownHeight="360" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ToolTip="Libro o cita completa, como Lucas 5:14. Pulsa Enter para buscar." AutomationProperties.Name="Libro de la Biblia"/>
                <ComboBox Grid.Column="1" x:Name="BibleChapterPicker" Margin="0,0,5,0" Padding="8,5,26,5" MinHeight="32" FontSize="12" SelectionChanged="BibleChapterChanged" MaxDropDownHeight="300" ToolTip="Capítulo" AutomationProperties.Name="Capítulo de la Biblia"/>
                <ComboBox Grid.Column="2" x:Name="BibleVersePicker" Margin="0,0,5,0" Padding="8,5,26,5" MinHeight="32" FontSize="12" SelectionChanged="BibleVerseChanged" MaxDropDownHeight="300" ToolTip="Versículo" AutomationProperties.Name="Versículo de la Biblia"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="PreviousBibleChapterButton" Content="‹" Style="{StaticResource CompactIconButton}" Click="PreviousBibleChapterClick" IsEnabled="False" ToolTip="Capítulo anterior" AutomationProperties.Name="Capítulo anterior"/>
                  <Button x:Name="NextBibleChapterButton" Content="›" Style="{StaticResource CompactIconButton}" Click="NextBibleChapterClick" IsEnabled="False" Margin="4,0,0,0" ToolTip="Capítulo siguiente" AutomationProperties.Name="Capítulo siguiente"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1" Margin="0,0,0,10">

                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="BibleQuery" TextChanged="BibleQueryChanged" PreviewKeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia" FontSize="13" MinHeight="40" ToolTip="Génesis 1:1-5 · Jn 3 16 · una frase"/>
                  <TextBlock Text="Ej. Juan 3:16" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BibleQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Button Grid.Column="1" Content="×" Style="{StaticResource CompactIconButton}" Click="ClearBibleQueryClick" Margin="4,0,0,0" ToolTip="Limpiar búsqueda (Esc)" AutomationProperties.Name="Limpiar búsqueda de la Biblia"/>
                  <Button Grid.Column="2" Content="Buscar" Visibility="Collapsed" Click="SearchBibleClick" Margin="4,0,0,0" Padding="10,5"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock x:Name="BibleResultText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="BibleSelectionText" Foreground="{StaticResource AccentTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
              <ListBox Grid.Row="4" x:Name="BibleResults" SelectionMode="Extended" SelectionChanged="BibleSelectionChanged" MouseDoubleClick="BibleResultsDoubleClick" PreviewKeyDown="BibleResultsKeyDown" AutomationProperties.Name="Resultados de Biblia">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="VerseRow" Background="Transparent" CornerRadius="2"
                                  BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="VerseRow" Property="Background" Value="#303136"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="VerseRow" Property="Background" Value="{StaticResource BibleSelectionBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                              <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                              </MultiTrigger.Conditions>
                              <Setter TargetName="VerseRow" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Reference}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border MinWidth="23" Height="23" Padding="3,0" CornerRadius="12" Background="{StaticResource RaisedBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding Verse.VerseNumber}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="7,1,0,0">
                    <TextBlock Text="{Binding Reference}" Visibility="{Binding ShowReference, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                  </StackPanel>
                </Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <ListBox Grid.Row="5" x:Name="BibleVersionPicker" SelectionChanged="BibleVersionChanged"
                       Margin="0,10,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                       SelectionMode="Single" IsEnabled="False" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Versión de la Biblia">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                      <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter/>
                      </ScrollViewer>
                    </Border>
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterChip}">
                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Padding" Value="7,7"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="VersionChip" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                  CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="VersionChip" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="VersionChip" Property="Background" Value="{StaticResource BibleSelectionBrush}"/>
                              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter TargetName="VersionChip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource BibleVersionLabelConverter}}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="Notas" ContentId="text" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="TextPanel" Background="#171719" CornerRadius="0" Padding="14,20,14,14">
  <Grid>
    <Grid x:Name="NotesOverview">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="＋ Nueva" Click="NewNoteClick" MinHeight="34" Padding="12,5" VerticalAlignment="Top" AutomationProperties.Name="Crear nota"/>
        <StackPanel><TextBlock Text="Notas del culto" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Solo tú las ves, a menos que las proyectes" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <TextBox x:Name="NotesSearchBox" TextChanged="NotesSearchChanged" AutomationProperties.Name="Buscar en las notas" ToolTip="Buscar en títulos y contenido" Padding="32,7,12,7" MinHeight="34"/>
        <Path Data="M10 6 A4 4 0 1 1 2 6 A4 4 0 1 1 10 6 M9 9L13 13" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
        <TextBlock Text="Buscar en notas…" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12" Foreground="{StaticResource MutedBrush}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NotesSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <WrapPanel x:Name="NotesFilters" Grid.Row="2" Margin="0,0,0,0">
        <ToggleButton Tag="all" Style="{StaticResource NotesFilterChip}" Click="NotesFilterClick" AutomationProperties.Name="Todas las notas"/>
        <ToggleButton Tag="sermon" Style="{StaticResource NotesFilterChip}" Click="NotesFilterClick" AutomationProperties.Name="Notas de sermón"/>
        <ToggleButton Tag="anuncio" Style="{StaticResource NotesFilterChip}" Click="NotesFilterClick" AutomationProperties.Name="Notas de anuncios"/>
        <ToggleButton Tag="oracion" Style="{StaticResource NotesFilterChip}" Click="NotesFilterClick" AutomationProperties.Name="Notas de oración"/>
        <ToggleButton Tag="recordatorio" Style="{StaticResource NotesFilterChip}" Click="NotesFilterClick" AutomationProperties.Name="Recordatorios"/>
      </WrapPanel>
      <Grid Grid.Row="3">
        <ListBox x:Name="NotesList" SelectionChanged="NotesSelectionChanged" AutomationProperties.Name="Notas guardadas en esta PC" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NoteFocus" BorderThickness="1" CornerRadius="16" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NoteFocus" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="3,10,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Border x:Name="NoteCard" Background="#1C1C1E" BorderBrush="#353537" BorderThickness="1" CornerRadius="16" Padding="12">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{Binding CategoryColor}" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                  <Viewbox Grid.Column="2" Width="13" Height="13" Margin="7,0,0,0" ToolTip="Fijada"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="24" Height="24"><Path Data="M16 9V3H8V9L5 12V15H19V12Z M12 15V22" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Fill="{StaticResource MutedBrush}" StrokeLineJoin="Round"/></Canvas></Viewbox>
                  <Viewbox Grid.Column="3" Width="14" Height="14" Margin="8,0,0,0" ToolTip="Visible en vista de moderador"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowInModerator}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="24" Height="24"><Path Data="M2 12C6 4 18 4 22 12C18 20 6 20 2 12Z M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.8"/></Canvas></Viewbox>
                  <Button x:Name="NoteCardDeleteButton" Grid.Column="4" Click="DeleteNoteClick" Width="28" Height="28" MinHeight="28" Padding="6" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" ToolTip="Eliminar nota" AutomationProperties.Name="Eliminar nota">
                    <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M3 6H21 M9 6V3H15V6 M5 6L6 21H18L19 6 M10 10V17 M14 10V17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="16,6,0,7"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                  <Border Background="{Binding CategoryBackground}" CornerRadius="8" Padding="6,2"><TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryColor}" FontWeight="Medium" FontSize="10"/></Border>
                  <TextBlock Text="{Binding ModifiedLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers><Trigger SourceName="NoteCard" Property="IsMouseOver" Value="True"><Setter TargetName="NoteCard" Property="BorderBrush" Value="#656567"/></Trigger></DataTemplate.Triggers>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NotesEmptyText" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel Grid.Row="4" Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="Vista de moderador" Click="OpenNotesModeratorClick" FontSize="10" MinHeight="28" Padding="8,4" AutomationProperties.Name="Abrir notas privadas del moderador"/>
        <TextBlock x:Name="NotesCountText" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Grid>
    <Grid x:Name="NotesEditor" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="NotesPinnedCheck" Content="Fijar" Click="NoteOptionsChanged" VerticalAlignment="Center" FontSize="11" Margin="5,0,9,0" AutomationProperties.Name="Fijar nota arriba"/>
          <Button Content="⋯" Click="NotesMoreClick" ToolTip="Más opciones de la nota" MinWidth="32" MinHeight="32" Padding="6,2"><Button.ContextMenu><ContextMenu><MenuItem Header="Duplicar nota" Click="DuplicateNoteClick"/><Separator/><MenuItem Header="Eliminar nota" Click="DeleteNoteClick"/></ContextMenu></Button.ContextMenu></Button>
        </StackPanel>
        <Button Content="‹ Notas" Click="NotesBackClick" HorizontalAlignment="Left" FontSize="12" Padding="9,5" MinHeight="32"/>
      </DockPanel>
      <ComboBox x:Name="NotesCategoryBox" Grid.Row="1" SelectedValuePath="Tag" SelectionChanged="NoteCategoryChanged" Margin="0,12,0,7" AutomationProperties.Name="Categoría de la nota"><ComboBoxItem Tag="sermon" Content="Sermón"/><ComboBoxItem Tag="anuncio" Content="Anuncio"/><ComboBoxItem Tag="oracion" Content="Oración"/><ComboBoxItem Tag="recordatorio" Content="Recordatorio"/></ComboBox>
      <StackPanel Grid.Row="2" Margin="0,4,0,6"><TextBlock Text="Título" Style="{StaticResource MutedText}" FontSize="11"/><TextBox x:Name="NotesTitleBox" FontSize="18" FontWeight="SemiBold" TextChanged="NotesChanged" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" AutomationProperties.Name="Título de la nota"/></StackPanel>
      <Grid Grid.Row="3"><TextBox x:Name="NotesBodyBox" TextChanged="NotesChanged" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" AutomationProperties.Name="Contenido de la nota"/>
        <TextBlock Text="Escribe aquí tus notas para el culto…" Margin="13,9,0,0" VerticalAlignment="Top" IsHitTestVisible="False" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NotesBodyBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Grid Grid.Row="4" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="NotesModeratorCheck" Style="{StaticResource ServiceSwitch}" Click="NoteOptionsChanged" AutomationProperties.Name="Mostrar nota en vista de moderador"/><TextBlock Grid.Column="1" Text="Mostrar en vista de moderador" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="9,0,0,0"/></Grid>
      <StackPanel Grid.Row="5" Margin="0,0,0,10"><TextBlock x:Name="NotesModifiedText" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="NotesSaveState" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
      <DockPanel Grid.Row="6">
        <Button x:Name="NotesDeleteButton" DockPanel.Dock="Right" Content="Eliminar" Click="DeleteNoteClick" Foreground="#EF9C9C" Background="Transparent" Margin="8,0,0,0" AutomationProperties.Name="Eliminar esta nota"/>
        <Button x:Name="NotesProjectButton" Content="Proyectar nota" Click="ProjectNoteClick" Background="{StaticResource ActionBrush}" Foreground="{StaticResource OnActionBrush}" AutomationProperties.Name="Proyectar o detener esta nota"/>
      </DockPanel>
    </Grid>
  </Grid>
          </Border>
</ad:LayoutAnchorable>

<ad:LayoutAnchorable Title="YouTube" ContentId="youtube" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="YouTubePanel" Background="{StaticResource YouTubePanelBrush}" CornerRadius="0" Padding="{StaticResource SourcePanelPadding}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button x:Name="OpenProjectionYouTubeButton" Grid.Row="0" Content="Abrir YouTube para proyección" Click="OpenProjectionYouTubeClick" MinHeight="36" FontSize="12" Padding="8,5" Margin="0,0,0,8" ToolTip="Abre una ventana de Chrome que sigue dibujando aunque otras aplicaciones la tapen. Usa una sesión propia de Culto Studio." AutomationProperties.Name="Abrir YouTube para proyección continua"/>
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Detectar YouTube" Click="RefreshYouTubeClick" Padding="9,5" MinHeight="32" FontSize="12" AutomationProperties.Name="Detectar YouTube en Chrome"/>
                <Button Grid.Column="1" Content="↻" Click="RefreshYouTubeClick" Margin="6,0,0,0" Padding="9,5" MinHeight="32" FontSize="12" AutomationProperties.Name="Actualizar ventanas de YouTube"/>
              </Grid>
              <StackPanel Grid.Row="2" Margin="2,0,0,8">
                <TextBlock x:Name="YouTubeCountText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Audio independiente: Chrome o Windows." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="3">
                <ListBox x:Name="YouTubeList" SelectionChanged="YouTubeSelectionChanged" MouseDoubleClick="YouTubeDoubleClick" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ventanas de YouTube">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="YouTubeCard" Background="Transparent" CornerRadius="{StaticResource ItemRadius}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="YouTubeCard" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="YouTubeCard" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="YouTubeCard" Property="Background" Value="{StaticResource FocusSurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                  </Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3">
                    <local:AspectRatioBox MaxWidth="260" HorizontalAlignment="Left" Margin="0,0,0,9"><Border CornerRadius="14" SizeChanged="MonitorFrameSizeChanged" Background="Black"><local:WindowCaptureThumbnail Cue="{Binding Cue}"/></Border></local:AspectRatioBox>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" ToolTip="{Binding Detail}"/>
                  </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="YouTubeEmpty" Text="Pulsa Abrir YouTube para proyección para mantener la imagen aunque otra aplicación tape Chrome. También puedes elegir una ventana de YouTube ya abierta." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="16,22" IsHitTestVisible="False"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="ProjectYouTubeButton" Content="Proyectar" Click="ProjectYouTubeClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinHeight="36" FontSize="12" Padding="6,5" Margin="0,0,3,0" AutomationProperties.Name="Proyectar ventana de YouTube"/>
                <Button x:Name="AddYouTubeButton" Grid.Column="1" Content="+ Al orden" Click="AddYouTubeToPlanClick" IsEnabled="False" MinHeight="36" FontSize="12" Padding="6,5" Margin="3,0,0,0" AutomationProperties.Name="Añadir captura de YouTube al orden"/>
              </Grid>
              <Grid Grid.Row="5" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="EditYouTubeButton" Content="Recorte" ToolTip="Editar captura" Click="EditYouTubeClick" IsEnabled="False" MinHeight="32" Padding="5,5" Margin="0,0,3,0" FontSize="12" AutomationProperties.Name="Editar el recorte y la posición de la captura"/>
                <Button Grid.Column="1" Content="Restaurar audio" Click="ReleaseCaptureAudioClick" MinHeight="32" Padding="5,5" Margin="3,0,0,0" FontSize="12" ToolTip="Restaurar niveles de audio que quedaron bajo control del programa. Chrome ahora conserva su sonido de forma independiente." AutomationProperties.Name="Restaurar audio de aplicaciones"/>
              </Grid>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane>
        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>
    </AdornerDecorator>
    <Grid Grid.Row="3" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="1" x:Name="UpdateAvailableButton" Content="Actualización disponible" Click="ShowAvailableUpdateClick" Visibility="Collapsed" Margin="12,0,0,0" Padding="10,3" AutomationProperties.Name="Ver actualización disponible"/>
    </Grid>
  </Grid>
</Window>
