<Window x:Class="Culto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Culto.Desktop"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
        xmlns:projection="clr-namespace:Culto.Desktop.Projection"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Culto Studio — Consola de iglesia" Width="1480" Height="900"
        MinWidth="1200" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <local:BibleVersionLabelConverter x:Key="BibleVersionLabelConverter"/>
    <SolidColorBrush x:Key="BibleSelectionBrush" Color="#395B88"/>
    <Thickness x:Key="SourcePanelPadding">14,24,14,14</Thickness>
    <ControlTemplate x:Key="WorkspaceSourceTabTemplate" TargetType="TabItem">
      <Grid>
        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="TabIndicator" Height="2" Background="{DynamicResource PanelTabSelectionBrush}" VerticalAlignment="Bottom"
                Margin="10,0" CornerRadius="1" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabSurface" Property="Background" Value="Transparent"/>
          <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
          <Setter Property="Foreground" Value="{DynamicResource PanelTabSelectionBrush}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
          <Setter Property="Foreground" Value="{DynamicResource PanelTabSelectionBrush}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="PanelCaptionTemplate" TargetType="{x:Type adc:AnchorablePaneTitle}">
      <Border Background="{TemplateBinding Background}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Model.Title, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
          <Button x:Name="CaptionMenu" Grid.Column="1" Click="PanelMenuClick" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="6" Background="Transparent" BorderThickness="0" ToolTip="Opciones del panel" AutomationProperties.Name="Opciones del panel">
            <Path Data="M 1,3 L 15,3 M 1,8 L 15,8 M 1,13 L 15,13" Width="14" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
          </Button>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="Grouped"><Setter TargetName="CaptionMenu" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:OrderNumberConverter x:Key="OrderNumberConverter"/>
    <Style x:Key="SceneButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="84"/><Setter Property="Height" Value="84"/>
      <Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Background" Value="#F6F8FA"/><Setter Property="Foreground" Value="#18232F"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="SceneSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <Border.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.24"/></Border.Effect>
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SceneSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SceneSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="AutomationProperties.ItemStatus" Value="En pantalla"><Setter TargetName="SceneSurface" Property="BorderBrush" Value="#39CF88"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="SceneSurface" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SceneSurface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerTime" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource ConsoleFont}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerLoop" TargetType="CheckBox">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid>
          <Border x:Name="LoopSurface" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
          <Path Data="M 5,7 L 16,7 M 13,4 L 16,7 L 13,10 M 15,15 L 4,15 M 7,12 L 4,15 L 7,18"
                Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse x:Name="LoopEnabled" Width="3" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource SelectedBrush}"/>
            <Setter TargetName="LoopEnabled" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource FocusSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource OnActionBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadiusConverter}}" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ActionBrush}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource FocusSurfaceBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="OrderItemTemplate">
      <Grid ToolTip="{Binding Title}" MinHeight="34">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="OrderNumber" Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}"
                   FontSize="10" Style="{StaticResource ItemMetadataText}" VerticalAlignment="Center"/>
        <local:MediaThumbnail Grid.Column="1" Cue="{Binding}" Width="46" Height="34" ShowDuration="True"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="OrderAnnouncer" Text="{Binding Announcer, StringFormat='Anuncia: {0}'}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Announcer}" Opacity="0.8"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="EN VIVO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OnActionBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Announcer}" Value=""><Setter TargetName="OrderAnnouncer" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Announcer}" Value="{x:Null}"><Setter TargetName="OrderAnnouncer" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive)}" Value="True">
          <Setter TargetName="OrderNumber" Property="Foreground" Value="{StaticResource OnActionBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="CompactCueRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="0"/>
    </Style>
    <DataTemplate x:Key="LibraryItemTemplate">
      <Grid Height="34" ToolTip="{Binding Title}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:MediaThumbnail Cue="{Binding}" Width="46" Height="34" ShowDuration="True"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

    <Style x:Key="MediaCardItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource LiveBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource FocusSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource OnActionBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <local:MediaPathConverter x:Key="MediaPathConverter"/>
    <ItemsPanelTemplate x:Key="MediaTilesPanel"><local:MediaTilePanel ItemWidth="184" FitThumbnailsToWidth="True"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="MediaRowsPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
    <Style x:Key="MediaTileItem" TargetType="ListBoxItem" BasedOn="{StaticResource MediaCardItem}">
      <Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <DataTemplate x:Key="MediaTileTemplate">
      <Grid ToolTip="{Binding Title}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
        <local:AspectRatioBox><local:MediaThumbnail Cue="{Binding}" CornerRadius="0" ShowDuration="True"/></local:AspectRatioBox>
        <Border Grid.Row="1" Background="{StaticResource CanvasBrush}">
          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="3,2" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MediaRowTemplate">
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LibraryItemTemplate}"/>
    </DataTemplate>
    <Style x:Key="OrderRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <Border x:Name="Stripe" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2" Margin="0,6"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True">
            <Setter TargetName="Row" Property="Background" Value="{StaticResource LiveBrush}"/>
            <Setter TargetName="Stripe" Property="Background" Value="{StaticResource OnActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource FocusSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource OnActionBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10,0,10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="6,0,6,4">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FileMenuButton" Content="_Archivo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Archivo">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Nuevo culto" Click="NewPlanClick"/>
            <MenuItem Header="Abrir culto…" Click="OpenPlanClick"/>
            <MenuItem Header="Guardar culto…" Click="SaveServiceClick"/>
            <MenuItem Header="Cultos guardados…" Click="SavedServicesClick"/>
            <MenuItem Header="Guardar una copia…" InputGestureText="Ctrl+S" Click="SavePlanClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="LibraryMenuButton" Content="_Biblioteca" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Administrar biblioteca">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Añadir archivos…" Click="ImportFilesClick"/>
            <MenuItem Header="Importar carpeta de himnos…" Click="ImportFolderClick"/>
            <MenuItem Header="Importar Biblia…" Click="ImportBibleClick"/>
            <MenuItem Header="Lista de videos…" Click="VideoCollectionsClick"/>
            <MenuItem Header="Añadir video a una colección…" Click="AddVideoToCollectionClick"/>
            <Separator/>
            <MenuItem Header="Captura de imagen de una pantalla…" Click="CaptureClick"/>
            <MenuItem Header="Editar el contenido seleccionado…" Click="EditLibraryClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="SettingsMenuButton" Content="_Configuración" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Configuración">
          <Button.ContextMenu><ContextMenu>
            <MenuItem x:Name="ChurchSettingsMenu" Header="Datos de la iglesia…" Click="ChurchSettingsClick"/>
            <MenuItem Header="Pantallas y salida…" Click="DisplayClick"/>
            <MenuItem Header="Transición del sistema…" Click="TransitionSettingsClick"/>
            <MenuItem Header="Presentador USB">
              <MenuItem x:Name="PresenterEnabledMenu" Header="Control en segundo plano" IsCheckable="True" Click="TogglePresenterClick" ToolTip="Captura Av Pág y Re Pág aunque otra aplicación esté activa."/>
              <MenuItem x:Name="PresenterArrowsMenu" Header="Usar flechas izquierda y derecha" IsCheckable="True" Click="TogglePresenterArrowsClick" ToolTip="Estas teclas del teclado también controlarán la salida mientras esté activado."/>
            </MenuItem>
            <MenuItem Header="Stream Deck">
              <MenuItem x:Name="StreamDeckPluginEnabledMenu" Header="Integración nativa con Elgato" IsCheckable="True" Click="ToggleStreamDeckPluginClick"/>
              <MenuItem Header="Instalar plugin en Elgato…" Click="InstallStreamDeckPluginClick"/>
              <MenuItem Header="Configurar plugin nativo…" Click="StreamDeckPluginHelpClick"/>
              <Separator/>
              <MenuItem x:Name="StreamDeckEnabledMenu" Header="Alternativa: teclas F13–F24" IsCheckable="True" Click="ToggleStreamDeckClick" ToolTip="Permite asignar F13 a F24 a los botones de tu Stream Deck."/>
              <MenuItem Header="Ver teclas alternativas…" Click="StreamDeckHelpClick"/>
            </MenuItem>
            <MenuItem Header="Logo…" Click="LogoSettingsClick"/>
            <MenuItem Header="Volver al contenido" Click="RestoreLogoContentClick"/>
            <MenuItem x:Name="RemoteButton" Header="Mando móvil…" Click="RemoteClick"/>
            <Separator/>
            <MenuItem x:Name="CheckUpdatesMenu" Header="Buscar actualizaciones…" Click="CheckUpdatesClick"/>
            <MenuItem x:Name="AutomaticUpdatesMenu" Header="Buscar actualizaciones al abrir" IsCheckable="True" IsChecked="True" Click="ToggleAutomaticUpdatesClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="WorkspaceMenuButton" Content="Espacio de trabajo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick">
          <Button.ContextMenu><ContextMenu Opened="WorkspacePanelsMenuOpened">
            <MenuItem Header="Escenas" Tag="scenes" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Monitores" Tag="preview" IsEnabled="False" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>

            <MenuItem Header="Orden del culto" Tag="order" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Himnario" Tag="sources" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Biblia" Tag="bible" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Notas" Tag="text" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="YouTube" Tag="youtube" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Medios" Tag="media" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Lista de videos" Tag="playlists" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="PowerPoint" Tag="powerpoint" IsCheckable="True" StaysOpenOnClick="True" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Mostrar todos los paneles" Click="ShowAllWorkspacePanelsClick"/>
            <Separator/>
            <MenuItem Header="Principal" Tag="principal" Click="WorkspacePresetClick"/>
            <MenuItem Header="Compacta" Tag="compacta" Click="WorkspacePresetClick"/>
            <MenuItem Header="Proyección" Tag="proyeccion" Click="WorkspacePresetClick"/>
            <Separator/>
            <MenuItem Header="Guardar distribución" Click="SaveDockLayoutClick"/>
            <MenuItem Header="Restablecer diseño principal" Click="ResetDockLayoutClick"/>
            <MenuItem Header="Recuperar distribución anterior" Click="RestoreLegacyWorkspaceClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
      <Grid x:Name="ConsoleHeaderDetails" Grid.Row="1" Margin="0,6,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Consola" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="ConsoleDateText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource PanelBrush}" CornerRadius="22" Padding="14,3" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Culto actual" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="PlanNameBox" Text="Culto del sábado" Width="166" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="2,5" MinHeight="32" LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/>
              <Border Background="{StaticResource InputBrush}" CornerRadius="14" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HeaderSaveState" Text="Local" FontSize="12" Foreground="{StaticResource MutedBrush}"/></Border>
            </StackPanel>
          </Border>
          <Button x:Name="RemoteTopButton" Click="RemoteClick" Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0" Background="{StaticResource TextBrush}" Foreground="{StaticResource OnActionBrush}" ToolTip="Control remoto ? Desactivado" AutomationProperties.Name="Control remoto">
            <Button.Template><ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="RemoteCircle" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="22"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RemoteCircle" Property="Opacity" Value="0.85"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RemoteCircle" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="RemoteCircle" Property="Opacity" Value="0.65"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Button.Template>
            <Grid Width="44" Height="44">
              <Ellipse x:Name="RemotePulse" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
              </Ellipse>
              <Path Data="M 3,1 L 11,1 Q 13,1 13,3 L 13,19 Q 13,21 11,21 L 3,21 Q 1,21 1,19 L 1,3 Q 1,1 3,1 M 5,18 L 9,18" Width="12" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
            </Grid>
          </Button>
          <Border Background="{StaticResource LiveSurfaceBrush}" CornerRadius="22" Padding="13,10" Margin="12,0,0,0"><StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OutputIndicator" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource LiveBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="SIN SALIDA"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="ENSAYO"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
