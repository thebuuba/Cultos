              <ListBox x:Name="LibraryFilter" Grid.Row="1" SelectedIndex="0" SelectionChanged="LibraryFilterChanged" ItemContainerStyle="{StaticResource FilterChip}" Margin="0,10,0,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Categoría de la biblioteca">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem Content="Todo"/><ListBoxItem Content="Himnos"/><ListBoxItem Content="Videos" Visibility="Collapsed"/><ListBoxItem Content="Imágenes" Visibility="Collapsed"/><ListBoxItem Content="Audio"/><ListBoxItem Content="Textos"/><ListBoxItem Content="Descargas" Visibility="Collapsed"/><ListBoxItem Content="PowerPoint"/>
              </ListBox>
              <Grid Grid.Row="2" Margin="2,4,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LibraryCountText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="RefreshFolderButton" Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Padding="8" MinWidth="30" MinHeight="30" Visibility="Collapsed" Click="RefreshFolderClick" ToolTip="Actualizar carpeta" AutomationProperties.Name="Actualizar carpeta"/>
              </Grid>
              <Grid Grid.Row="3">
                <ListBox x:Name="LibraryList" ItemTemplate="{StaticResource LibraryItemTemplate}" SelectionChanged="LibrarySelectionChanged" MouseDoubleClick="LibraryDoubleClick" AutomationProperties.Name="Biblioteca de contenidos"/>
                <TextBlock x:Name="LibraryEmpty" Text="Biblioteca vacía" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="18,30" TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="+ Al orden" Click="AddLibraryToPlanClick" Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource SelectedBrush}" MinHeight="36" FontSize="12" Padding="8,5"/>
                <Button Grid.Column="1" Content="⋯" ToolTip="Lista de videos" Click="VideoCollectionsClick" Margin="6,0,0,0" Padding="10,6" MinHeight="40"/>
              </Grid>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="PowerPoint" ContentId="powerpoint" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
  <Border x:Name="PowerPointPanel" Background="{StaticResource PanelBrush}" Padding="14,4,14,14">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,10">
        <Button Content="+ Agregar PowerPoint" Click="ImportPowerPointClick" MinHeight="36" AutomationProperties.Name="Agregar presentaciones de PowerPoint"/>
        <TextBlock Text="Archivos de presentación" Style="{StaticResource MutedText}" Margin="2,10,0,0" FontSize="12"/>
      </StackPanel>
      <Grid Grid.Row="1" MinHeight="64">
        <ListBox x:Name="PowerPointFiles" SelectionChanged="PowerPointSelectionChanged" MouseDoubleClick="PowerPointDoubleClick" PreviewKeyDown="PowerPointKeyDown" AutomationProperties.Name="Presentaciones de PowerPoint">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis" Padding="4,6"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PowerPointEmpty" Text="Agrega tus archivos .pptx, .ppt, .ppsx o .pps." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="16" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="PowerPointProjectButton" Content="Proyectar" Click="ProjectPowerPointClick" Background="{StaticResource ActionBrush}" Foreground="{StaticResource OnActionBrush}" MinHeight="36" Margin="0,0,4,0"/>
          <Button x:Name="PowerPointAddToPlanButton" Grid.Column="1" Content="+ Al orden" Click="AddPowerPointToPlanClick" MinHeight="36" Margin="4,0,0,0"/>
        </Grid>
        <TextBlock x:Name="PowerPointLiveText" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="PowerPointPositionText" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,8"/>
        <UniformGrid x:Name="PowerPointPlaybackPanel" Columns="2" Rows="2">
          <Button x:Name="PowerPointPreviousButton" Content="‹ Anterior" Click="PowerPointPreviousClick" MinHeight="36" Margin="0,0,4,4" ToolTip="Retrocede una animación o diapositiva"/>
          <Button x:Name="PowerPointNextButton" Content="Siguiente ›" Click="PowerPointNextClick" MinHeight="36" Margin="4,0,0,4" ToolTip="Avanza una animación o diapositiva"/>
          <Button x:Name="PowerPointPauseButton" Content="Pausar" Click="PowerPointPauseClick" MinHeight="36" Margin="0,4,4,0"/>
          <Button x:Name="PowerPointRestartButton" Content="Reiniciar" Click="PowerPointRestartClick" MinHeight="36" Margin="4,4,0,0" ToolTip="Volver a la primera diapositiva"/>
        </UniformGrid>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <CheckBox x:Name="PowerPointUsbCheck" Content="Controlar con presentador USB" Click="TogglePresenterClick" FontSize="12" Margin="0,0,0,6"/>
        <ComboBox x:Name="PowerPointUsbKeys" SelectionChanged="PowerPointUsbKeysChanged" AutomationProperties.Name="Teclas del presentador USB" MinHeight="32">
          <ComboBoxItem Content="Av Pág / Re Pág"/><ComboBoxItem Content="Flechas derecha / izquierda"/>
        </ComboBox>
        <TextBlock x:Name="PowerPointUsbStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="Biblia" ContentId="bible" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="BiblePanel" Background="{StaticResource PanelBrush}" CornerRadius="0" Padding="14,4,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="BibleNameText" Text="Biblia" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="BibleStatusText" Text="Sin Biblia cargada" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⋯" Style="{StaticResource CompactIconButton}" ToolTip="Estilo de la Biblia" Click="BibleStyleClick" AutomationProperties.Name="Editar estilo de la Biblia"/>
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,6,0"><TextBlock Text="Libro" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleBookPicker" Background="{StaticResource TextBrush}" Foreground="{StaticResource OnActionBrush}" SelectionChanged="BibleBookChanged" MaxDropDownHeight="360" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" AutomationProperties.Name="Libro de la Biblia"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Cap." Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleChapterPicker" SelectionChanged="BibleChapterChanged" MaxDropDownHeight="300" AutomationProperties.Name="Capítulo de la Biblia"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,6,6,0"><TextBlock Text="Vers." Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleVersePicker" SelectionChanged="BibleVerseChanged" MaxDropDownHeight="300" AutomationProperties.Name="Versículo de la Biblia"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Button x:Name="PreviousBibleChapterButton" Content="‹" Style="{StaticResource CompactIconButton}" Click="PreviousBibleChapterClick" IsEnabled="False" ToolTip="Capítulo anterior" AutomationProperties.Name="Capítulo anterior"/>
                  <Button x:Name="NextBibleChapterButton" Content="›" Style="{StaticResource CompactIconButton}" Click="NextBibleChapterClick" IsEnabled="False" Margin="4,0,0,0" ToolTip="Capítulo siguiente" AutomationProperties.Name="Capítulo siguiente"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1" Margin="0,0,0,10">

                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="BibleQuery" TextChanged="BibleQueryChanged" PreviewKeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia" FontSize="13" MinHeight="40" ToolTip="Génesis 1:1-5 · Jn 3 16 · una frase"/>
                  <TextBlock Text="Ej. Juan 3:16" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BibleQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Button Grid.Column="1" Content="×" Style="{StaticResource CompactIconButton}" Click="ClearBibleQueryClick" Margin="4,0,0,0" ToolTip="Limpiar búsqueda (Esc)" AutomationProperties.Name="Limpiar búsqueda de la Biblia"/>
                  <Button Grid.Column="2" Content="Buscar" Visibility="Collapsed" Click="SearchBibleClick" Margin="4,0,0,0" Padding="10,5"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock x:Name="BibleResultText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="BibleSelectionText" Foreground="{StaticResource AccentTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
              <ListBox Grid.Row="4" x:Name="BibleResults" SelectionMode="Extended" SelectionChanged="BibleSelectionChanged" MouseDoubleClick="BibleResultsDoubleClick" PreviewKeyDown="BibleResultsKeyDown" AutomationProperties.Name="Resultados de Biblia">
                <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Reference}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="23" Height="23" CornerRadius="12" Background="{StaticResource RaisedBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding Verse.Verse}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="7,1,0,0">
                    <TextBlock Text="{Binding Reference}" Visibility="{Binding ShowReference, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                  </StackPanel>
                </Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="AddSelectedBibleButton" Content="+ Versículo al orden" Click="AddSelectedBibleToPlanClick" FontSize="12" Padding="6,7" MinHeight="38"/>
                <Button Grid.Row="1" x:Name="AddBiblePassageButton" Content="Pasaje" Click="AddBibleToPlanClick" Visibility="Collapsed" Margin="0,6,0,0" FontSize="12" Padding="6,7" MinHeight="38"/>
              </Grid>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="Texto" ContentId="text" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="TextPanel" Background="{StaticResource PanelBrush}" CornerRadius="0" Padding="14,4,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Título" Style="{StaticResource MutedText}"/>
                <TextBox x:Name="TextTitleBox" Text="Bienvenidos" Margin="0,6,0,12" AutomationProperties.Name="Título del texto"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Mensaje para la congregación" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Grid.Row="2" x:Name="TextBodyBox" Text="Nos alegra compartir este culto contigo." AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="17" AutomationProperties.Name="Texto para proyectar"/>
              <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Button Content="Preparar texto" Click="PrepareTextClick" MinHeight="40"/>
                <Button Content="+ Guardar en biblioteca y orden" Click="SaveTextClick" Margin="0,6,0,0" MinHeight="40"/>
              </StackPanel>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
<ad:LayoutAnchorable Title="YouTube" ContentId="youtube" CanClose="False" CanHide="True" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="YouTubePanel" Background="{StaticResource YouTubePanelBrush}" CornerRadius="0" Padding="14,4,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button x:Name="OpenProjectionYouTubeButton" Grid.Row="0" Content="Abrir YouTube para proyección" Click="OpenProjectionYouTubeClick" MinHeight="36" FontSize="12" Padding="8,5" Margin="0,0,0,8" ToolTip="Abre una ventana de Chrome que sigue dibujando aunque otras aplicaciones la tapen. Usa una sesión propia de Culto Studio." AutomationProperties.Name="Abrir YouTube para proyección continua"/>
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Detectar YouTube" Click="RefreshYouTubeClick" Padding="9,5" MinHeight="32" FontSize="12" AutomationProperties.Name="Detectar YouTube en Chrome"/>
                <Button Grid.Column="1" Content="↻" Click="RefreshYouTubeClick" Margin="6,0,0,0" Padding="9,5" MinHeight="32" FontSize="12" AutomationProperties.Name="Actualizar ventanas de YouTube"/>
              </Grid>
              <StackPanel Grid.Row="2" Margin="2,0,0,8">
                <TextBlock x:Name="YouTubeCountText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Audio independiente: Chrome o Windows." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <Grid Grid.Row="3">
                <ListBox x:Name="YouTubeList" SelectionChanged="YouTubeSelectionChanged" MouseDoubleClick="YouTubeDoubleClick" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ventanas de YouTube">
                  <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3">
                    <local:AspectRatioBox MaxWidth="260" HorizontalAlignment="Left" Margin="0,0,0,9"><Border CornerRadius="14" SizeChanged="MonitorFrameSizeChanged" Background="Black"><local:CueThumbnail Cue="{Binding Cue}"/></Border></local:AspectRatioBox>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" ToolTip="{Binding Detail}"/>
                  </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="YouTubeEmpty" Text="Pulsa Abrir YouTube para proyección para mantener la imagen aunque otra aplicación tape Chrome. También puedes elegir una ventana de YouTube ya abierta." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="16,22" IsHitTestVisible="False"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="ProjectYouTubeButton" Content="Proyectar" Click="ProjectYouTubeClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinHeight="36" FontSize="12" Padding="6,5" Margin="0,0,3,0" AutomationProperties.Name="Proyectar ventana de YouTube"/>
                <Button x:Name="AddYouTubeButton" Grid.Column="1" Content="+ Al orden" Click="AddYouTubeToPlanClick" IsEnabled="False" MinHeight="36" FontSize="12" Padding="6,5" Margin="3,0,0,0" AutomationProperties.Name="Añadir captura de YouTube al orden"/>
              </Grid>
              <Grid Grid.Row="5" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="EditYouTubeButton" Content="Recorte" ToolTip="Editar captura" Click="EditYouTubeClick" IsEnabled="False" MinHeight="32" Padding="5,5" Margin="0,0,3,0" FontSize="12" AutomationProperties.Name="Editar el recorte y la posición de la captura"/>
                <Button Grid.Column="1" Content="Restaurar audio" Click="ReleaseCaptureAudioClick" MinHeight="32" Padding="5,5" Margin="3,0,0,0" FontSize="12" ToolTip="Restaurar niveles de audio que quedaron bajo control del programa. Chrome ahora conserva su sonido de forma independiente." AutomationProperties.Name="Restaurar audio de aplicaciones"/>
              </Grid>
            </Grid>
          </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane>
        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>
    </AdornerDecorator>
    <Grid Grid.Row="3" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
