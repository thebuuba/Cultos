                              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DisplayButtonSurface" Property="Background" Value="#3A3A3A"/></Trigger>
                              <Trigger Property="IsPressed" Value="True"><Setter TargetName="DisplayButtonSurface" Property="Background" Value="#454545"/></Trigger>
                              <Trigger Property="local:KeyboardFocusCue.IsVisible" Value="True"><Setter TargetName="DisplayButtonSurface" Property="BorderBrush" Value="{StaticResource TextBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                          <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M 2,2 L 14,2 Q 15,2 15,3 L 15,10 Q 15,11 14,11 L 2,11 Q 1,11 1,10 L 1,3 Q 1,2 2,2 M 8,11 L 8,14 M 5,14 L 11,14"/>
                          </Viewbox>
                          <TextBlock x:Name="OutputDisplayName" Text="Pantalla" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <ToggleButton x:Name="ToggleOutputButton" Click="ToggleOutputClick" Width="40" Height="36" Margin="0" Padding="0" AutomationProperties.Name="Activar salida" ToolTip="Activar salida">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                              <Border x:Name="SwitchTrack" Width="36" Height="20" CornerRadius="10" Background="#666666"/>
                              <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#252525" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                              <Border x:Name="SwitchFocus" CornerRadius="13" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" Height="26" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#BEF667"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0"/>
                              </Trigger>
                              <Trigger Property="local:KeyboardFocusCue.IsVisible" Value="True"><Setter TargetName="SwitchFocus" Property="Opacity" Value="1"/></Trigger>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/></Trigger>
                              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </Grid>

            </Grid>
            </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border></Grid></Border>
</ad:LayoutAnchorable>
