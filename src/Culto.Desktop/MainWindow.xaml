<Window x:Class="Culto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Culto.Desktop"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
        xmlns:projection="clr-namespace:Culto.Desktop.Projection"
        Title="Culto Studio — Consola de iglesia" Width="1480" Height="900"
        MinWidth="1200" MinHeight="680" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:OrderNumberConverter x:Key="OrderNumberConverter"/>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#262130"/><Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="PlayerTime" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerLoop" TargetType="CheckBox">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid>
          <Border x:Name="LoopSurface" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
          <Path Data="M 5,7 L 16,7 M 13,4 L 16,7 L 13,10 M 15,15 L 4,15 M 7,12 L 4,15 L 7,18"
                Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse x:Name="LoopEnabled" Width="3" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource SelectedBrush}"/>
            <Setter TargetName="LoopEnabled" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LoopSurface" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="SkipBackIcon">
      <Grid Width="22" Height="22">
        <Path Data="M 4,7 A 8,8 0 1 1 3,15 M 4,2 L 4,7 L 9,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock Text="10" FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,3,0,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SkipForwardIcon">
      <Grid Width="22" Height="22">
        <Path Data="M 18,7 A 8,8 0 1 0 19,15 M 18,2 L 18,7 L 13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock Text="10" FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,3,0,0"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent">
              <Border x:Name="Grip" Background="{StaticResource BorderBrush}" Width="2" Height="42" CornerRadius="1" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AmberBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadiusConverter}}" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectedBrush}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="#8E78BD"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="OrderItemTemplate">
      <Grid ToolTip="{Binding Title}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="26" Height="28" Background="Transparent" VerticalAlignment="Top">
          <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="EN VIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LiveBrush}" Margin="10,0,0,0"
                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LibraryItemTemplate">
      <Grid ToolTip="{Binding Title}" MinHeight="30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="KindBadge" Width="28" Height="28" CornerRadius="8" Background="#483B58" VerticalAlignment="Center">
          <Path x:Name="KindIcon" Data="M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,7 L 13,7 M 7,10 L 13,10 M 7,13 L 11,13"
                Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Width="15" Height="17" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Video">
          <Setter TargetName="KindIcon" Property="Data" Value="M 5,3 L 17,10 L 5,17 Z"/>
          <Setter TargetName="KindBadge" Property="Background" Value="#443B57"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Audio">
          <Setter TargetName="KindBadge" Property="Background" Value="#4C3B53"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 8,14 L 8,4 L 17,2 L 17,12 M 8,14 C 8,18 1,18 1,15 C 1,12 8,12 8,14 M 17,12 C 17,16 10,16 10,13 C 10,10 17,10 17,12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image">
          <Setter TargetName="KindBadge" Property="Background" Value="#344D49"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 2,3 L 18,3 L 18,17 L 2,17 Z M 2,14 L 8,8 L 13,13 L 16,10 L 18,12"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SequenceItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource LiveBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="SequenceTemplate">
      <StackPanel Width="124" ToolTip="{Binding Title}">
        <Grid Height="70">
          <local:CueThumbnail Cue="{Binding}"/>
          <Border Background="#CC24222D" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
          </Border>
          <Ellipse Width="6" Height="6" Fill="{StaticResource LiveBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
        <TextBlock Text="{Binding Title}" FontSize="10" Margin="2,3,2,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="OrderRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <Border x:Name="Stripe" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2" Margin="0,6"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}"/><Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource LiveBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10,0,10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="#302D38" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,7" Margin="-10,0,-10,0">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FileMenuButton" Content="_Archivo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Archivo">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Nuevo culto" Click="NewPlanClick"/>
            <MenuItem Header="Abrir culto…" Click="OpenPlanClick"/>
            <MenuItem Header="Guardar una copia…" InputGestureText="Ctrl+S" Click="SavePlanClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="LibraryMenuButton" Content="_Biblioteca" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Administrar biblioteca">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Añadir archivos…" Click="ImportFilesClick"/>
            <MenuItem Header="Importar carpeta de himnos…" Click="ImportFolderClick"/>
            <MenuItem Header="Importar Biblia…" Click="ImportBibleClick"/>
            <Separator/>
            <MenuItem Header="Capturar una pantalla…" Click="CaptureClick"/>
            <MenuItem Header="Editar el contenido seleccionado…" Click="EditLibraryClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="SettingsMenuButton" Content="_Configuración" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Configuración">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Pantallas y salida…" Click="DisplayClick"/>
            <MenuItem Header="Fondos de iglesia…" Click="ChurchBackgroundClick"/>
            <MenuItem x:Name="RemoteButton" Header="Mando móvil…" Click="RemoteClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="WorkspaceMenuButton" Content="Espacio de trabajo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Vista previa" Tag="preview" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="En pantalla" Tag="output" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Orden del culto" Tag="order" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Biblioteca y Biblia" Tag="sources" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Secuencia" Tag="sequence" Click="ShowWorkspacePanelClick"/>
            <Separator/>
            <MenuItem Header="Guardar distribución" Click="SaveDockLayoutClick"/>
            <MenuItem Header="Restablecer distribución" Click="ResetDockLayoutClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="Culto actual" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="PlanNameBox" Text="Culto del sábado" Width="240" FontSize="13" Padding="10,5" MinHeight="32"
                 LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/>
        <Border Background="{StaticResource InputBrush}" BorderBrush="#786798" BorderThickness="1" CornerRadius="15" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OutputIndicator" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource LiveBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="SIN SALIDA"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="ENSAYO"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="NEGRO"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="FONDO"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
                </Style.Triggers>
              </Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding Text, ElementName=OutputModeText}" Foreground="{Binding Fill, ElementName=OutputIndicator}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </Border>

    <ad:DockingManager x:Name="WorkspaceDock" local:LiveDockResize.IsEnabled="True" Grid.Row="2" BorderThickness="0" Background="{StaticResource CanvasBrush}" AllowMixedOrientation="True">
      <ad:DockingManager.Theme><themes:ArcDarkTheme/></ad:DockingManager.Theme>
      <ad:LayoutRoot>
        <ad:LayoutPanel Orientation="Horizontal">
          <ad:LayoutPanel Orientation="Vertical" DockWidth="2.4*">
            <ad:LayoutPanel Orientation="Horizontal" DockHeight="1.5*">
<ad:LayoutAnchorablePane DockWidth="*" DockHeight="*" DockMinWidth="280" DockMinHeight="340">
<ad:LayoutAnchorable Title="Vista previa" ContentId="preview" CanClose="False" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="PreviewPanel" Background="#25232C" CornerRadius="8" Padding="12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="Vista previa" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="16:9 · SIN SONIDO" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <local:AspectRatioBox Grid.Row="1" Margin="0,10,0,12" VerticalAlignment="Top">
              <Border x:Name="PreviewViewport" BorderBrush="#51495F" BorderThickness="1" Background="#101722">
                <ContentControl x:Name="PreviewHost" MinHeight="80"/>
              </Border>
            </local:AspectRatioBox>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PreparedTitleText" Text="Sin contenido" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Button x:Name="ProjectButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="ProjectClick" MinHeight="34" Padding="14,7" AutomationProperties.Name="Proyectar contenido preparado">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Proyectar a pantalla" FontSize="12"/><TextBlock Text="F5" FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.75"/></StackPanel>
              </Button>
            </Grid>
            <Grid Grid.Row="3" x:Name="PreviewPlaybackPanel" Visibility="Collapsed" Margin="0,8,0,0">
              <Border Background="#211F28" CornerRadius="16" Padding="0,3,0,5">
                <Grid x:Name="PreviewTransportGrid">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="4"/><ColumnDefinition Width="40"/><ColumnDefinition Width="4"/><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                  <Slider x:Name="PreviewPositionSlider" Grid.ColumnSpan="9" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True" Margin="6,0" PreviewMouseLeftButtonUp="PreviewPositionSeek" PreviewKeyUp="PreviewPositionKeyUp" AutomationProperties.Name="Avance de la vista previa"/>
                  <TextBlock x:Name="PreviewTimeText" Grid.Row="1" Grid.ColumnSpan="4" Text="00:00" Style="{StaticResource PlayerTime}" Margin="8,0,0,5"/>
                  <TextBlock x:Name="PreviewDurationText" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="4" Text="00:00" Style="{StaticResource PlayerTime}" HorizontalAlignment="Right" Margin="0,0,8,5"/>
                  <Button x:Name="PreviewRestartButton" Grid.Row="2" Content="&#xE72C;" Style="{StaticResource PlayerButton}" Click="PreviewRestartClick" ToolTip="Reiniciar vista previa" AutomationProperties.Name="Reiniciar vista previa"/>
                  <Button x:Name="PreviewSkipBackButton" Grid.Row="2" Grid.Column="2" Content="10" ContentTemplate="{StaticResource SkipBackIcon}" Style="{StaticResource PlayerButton}" Click="PreviewSkipBackClick" ToolTip="Retroceder 10 segundos en la vista previa" AutomationProperties.Name="Retroceder 10 segundos en la vista previa"/>
                  <Button x:Name="PreviewPauseButton" Grid.Row="2" Grid.Column="4" Content="&#xE769;" Style="{StaticResource PlayerPrimaryButton}" Click="PreviewPauseClick" ToolTip="Pausar vista previa" AutomationProperties.Name="Pausar vista previa"/>
                  <Button x:Name="PreviewSkipForwardButton" Grid.Row="2" Grid.Column="6" Content="10" ContentTemplate="{StaticResource SkipForwardIcon}" Style="{StaticResource PlayerButton}" Click="PreviewSkipForwardClick" ToolTip="Avanzar 10 segundos en la vista previa" AutomationProperties.Name="Avanzar 10 segundos en la vista previa"/>
                  <TextBlock Grid.Row="2" Grid.Column="8" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Vista previa sin sonido" AutomationProperties.Name="Vista previa sin sonido"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane><ad:LayoutAnchorablePane DockWidth="*" DockHeight="*" DockMinWidth="220" DockMinHeight="330">
<ad:LayoutAnchorable Title="En pantalla" ContentId="output" CanClose="False" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="LivePanel" Background="#302D38" BorderBrush="#48414F" BorderThickness="1,0,0,0" CornerRadius="6" Padding="10,8" SizeChanged="OutputPanelSizeChanged">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="LiveHeaderGrid">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="#273E38" CornerRadius="9" Padding="7,3" Margin="0,0,9,0"><TextBlock Text="En pantalla" Foreground="{StaticResource LiveBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
              <TextBlock Grid.Column="1" x:Name="LiveTitleText" Text="Sin contenido" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock Grid.Column="2" x:Name="OutputModeText" Text="SIN SALIDA" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding Text, ElementName=OutputStatusText}"/>
            </Grid>
            <local:AspectRatioBox Grid.Row="1" Margin="0,10,0,12" VerticalAlignment="Top">
              <Border x:Name="OutputViewport" BorderBrush="#47796B" BorderThickness="1" Background="#101722">
                <projection:OutputMonitor x:Name="LiveMonitor" MinHeight="80" AutomationProperties.Name="Monitor de la salida real"/>
              </Border>
            </local:AspectRatioBox>
            <UniformGrid Grid.Row="2" x:Name="ScreenNavigationPanel" Columns="2">
              <Button Content="Anterior" Click="PreviousClick" Margin="0,0,5,0" MinHeight="30" Padding="4,5" FontSize="11"/>
              <Button Content="Siguiente" Click="NextClick" Margin="0,0,5,0" MinHeight="30" Padding="4,5" FontSize="11"/>
            </UniformGrid>
            <ScrollViewer Grid.Row="3" x:Name="LiveScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" MaxHeight="200">
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,5,0,0">
              <TextBlock x:Name="LiveBodyText" Text="La salida está cerrada." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="18" TextTrimming="CharacterEllipsis">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=MediaPlaybackPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock x:Name="LiveReferenceText" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="OutputStatusText" Text="Una salida HDMI · tres pantallas iguales" Visibility="Collapsed"/>
            </StackPanel>
            <Grid Grid.Row="1" x:Name="OutputActionsGrid" Margin="0,4,0,6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="NextLiveText" Text="Sin contenido en salida" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Button Grid.Column="1" x:Name="ChooseOutputButton" Content="Pantalla…" Click="DisplayClick" FontSize="10" MinHeight="28" Padding="8,4" Margin="5,0"/>
              <Button Grid.Column="2" x:Name="ToggleOutputButton" Content="Activar HDMI" Click="ToggleOutputClick" FontSize="10" MinHeight="28" Padding="8,4"/>
            </Grid>
            <Grid Grid.Row="3" x:Name="MediaPlaybackPanel" Visibility="Collapsed" Margin="0,6,0,0">
              <Border Background="#24222B" CornerRadius="16" Padding="0,3,0,5">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid x:Name="OutputTransportGrid">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="4"/><ColumnDefinition Width="40"/><ColumnDefinition Width="4"/><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <Slider x:Name="PositionSlider" Grid.ColumnSpan="9" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True" Margin="6,0" PreviewMouseLeftButtonUp="PositionSeek" AutomationProperties.Name="Posición del video"/>
                    <TextBlock x:Name="TimeText" Grid.Row="1" Grid.ColumnSpan="4" Text="00:00" Style="{StaticResource PlayerTime}" Margin="8,0,0,5"/>
                    <TextBlock x:Name="OutputDurationText" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="4" Text="00:00" Style="{StaticResource PlayerTime}" HorizontalAlignment="Right" Margin="0,0,8,5"/>
                    <Button x:Name="RestartOutputButton" Grid.Row="2" Content="&#xE72C;" Style="{StaticResource PlayerButton}" Click="RestartClick" ToolTip="Reiniciar reproducción" AutomationProperties.Name="Reiniciar reproducción"/>
                    <Button x:Name="OutputSkipBackButton" Grid.Row="2" Grid.Column="2" Content="10" ContentTemplate="{StaticResource SkipBackIcon}" Style="{StaticResource PlayerButton}" Click="OutputSkipBackClick" ToolTip="Retroceder 10 segundos" AutomationProperties.Name="Retroceder 10 segundos"/>
                    <Button x:Name="PauseButton" Grid.Row="2" Grid.Column="4" Content="&#xE769;" Style="{StaticResource PlayerPrimaryButton}" Click="PauseClick" ToolTip="Pausar reproducción" AutomationProperties.Name="Pausar reproducción"/>
                    <Button x:Name="OutputSkipForwardButton" Grid.Row="2" Grid.Column="6" Content="10" ContentTemplate="{StaticResource SkipForwardIcon}" Style="{StaticResource PlayerButton}" Click="OutputSkipForwardClick" ToolTip="Avanzar 10 segundos" AutomationProperties.Name="Avanzar 10 segundos"/>
                    <CheckBox x:Name="LoopCheck" Grid.Row="2" Grid.Column="8" Style="{StaticResource PlayerLoop}" Checked="LoopChanged" Unchecked="LoopChanged" ToolTip="Repetir reproducción" AutomationProperties.Name="Repetir reproducción"/>
                  </Grid>
                  <Grid Grid.Row="1" Margin="0,5,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource PlayerButton}" Click="ToggleMuteClick" ToolTip="Silenciar salida" AutomationProperties.Name="Silenciar salida"/>
                    <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True" ValueChanged="VolumeChanged" Margin="5,0,8,0" AutomationProperties.Name="Volumen de la proyección"/>
                    <TextBlock Grid.Column="2" x:Name="VolumeText" Text="80 %" Style="{StaticResource PlayerTime}" HorizontalAlignment="Right"/>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            </Grid>
            </ScrollViewer>
            <UniformGrid Grid.Row="4" x:Name="OutputBackdropsPanel" Columns="2" Margin="0,8,0,0">
              <Button x:Name="ChurchBackgroundButton" Content="Fondo iglesia" Click="ChurchBackgroundClick" Margin="0,0,5,0" MinHeight="42" Padding="4,7" FontSize="10" AutomationProperties.Name="Fondo iglesia">
                <Button.ContextMenu><ContextMenu>
                  <MenuItem Header="Elegir fondo…" Click="ChurchBackgroundClick"/>
                  <MenuItem Header="Agregar imagen…" Click="ChangeChurchBackgroundClick"/>
                  <MenuItem Header="Usar fondo sencillo" Click="ClearChurchBackgroundClick"/>
                </ContextMenu></Button.ContextMenu>
              </Button>
              <Button x:Name="BlackoutButton" Content="Fondo negro" Click="BlackBackgroundClick" MinHeight="42" Padding="4,7" FontSize="10" AutomationProperties.Name="Fondo negro"/>
            </UniformGrid>
          </Grid>
        </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane>
            </ad:LayoutPanel>
            <ad:LayoutPanel Orientation="Horizontal" DockHeight="*">
<ad:LayoutAnchorablePane DockWidth="0.8*" DockHeight="*" DockMinWidth="240" DockMinHeight="160">
<ad:LayoutAnchorable Title="Orden del culto" ContentId="order" CanClose="False" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="OrderPanel" Background="#2B2933" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Orden del culto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="PlanCountText" Text="0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Grid.Column="2" Content="⋯" Click="OpenActionsClick" Padding="8,2" MinHeight="30" FontSize="18" AutomationProperties.Name="Organizar el orden">
              <Button.ContextMenu><ContextMenu>
                <MenuItem Header="Subir elemento" Click="MoveUpClick"/>
                <MenuItem Header="Bajar elemento" Click="MoveDownClick"/>
                <Separator/>
                <MenuItem Header="Quitar del orden" Click="RemoveCueClick"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <local:OrderListBox x:Name="PlanList" ItemContainerStyle="{StaticResource OrderRow}" ItemTemplate="{StaticResource OrderItemTemplate}" Style="{StaticResource {x:Type ListBox}}"
                     SelectionChanged="PlanSelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="PlanMouseDown" PreviewMouseLeftButtonUp="PlanMouseUp" MouseDoubleClick="PlanDoubleClick" MouseMove="PlanMouseMove" Drop="PlanDrop" AutomationProperties.Name="Orden de culto"/>
            <TextBlock x:Name="PlanEmptyText" Text="Orden vacío" Style="{StaticResource MutedText}" Margin="12,24" TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="AddOrderButton" Background="{StaticResource SelectedBrush}" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource SelectedBrush}" Click="OpenActionsClick" MinHeight="40" Padding="10,5" HorizontalContentAlignment="Center" AutomationProperties.Name="Agregar al orden de culto">
                <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="23" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Agregar" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu><ContextMenu>
                  <MenuItem x:Name="AddOrderLibrary" Header="Himno o contenido de biblioteca…" Tag="0" Click="AddOrderSourceClick"/>
                  <MenuItem x:Name="AddOrderBible" Header="Pasaje de la Biblia…" Tag="1" Click="AddOrderSourceClick"/>
                  <MenuItem x:Name="AddOrderText" Header="Texto o anuncio…" Tag="2" Click="AddOrderSourceClick"/>
                  <Separator/>
                  <MenuItem Header="Videos, imágenes o audio desde archivos…" Click="AddOrderFilesClick"/>
                </ContextMenu></Button.ContextMenu>
              </Button>
              <Button Grid.Column="1" x:Name="NotesToggleButton" Content="Notas" Click="ToggleNotesClick" Margin="6,0,0,0" MinHeight="40" Padding="8,5" FontSize="12" AutomationProperties.Name="Notas del elemento"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="3" x:Name="NotesPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Notas privadas" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
            <TextBox x:Name="NotesBox" Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" LostFocus="NotesChanged" AutomationProperties.Name="Notas privadas del elemento"/>
          </StackPanel>
        </Grid>
      </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane><ad:LayoutAnchorablePane DockWidth="*" DockHeight="*" DockMinWidth="240" DockMinHeight="150">
<ad:LayoutAnchorable Title="Secuencia" ContentId="sequence" CanClose="False" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="SequencePanel" Background="#2B2833" CornerRadius="8" Padding="5,5,3,2" >
          <local:OrderListBox x:Name="SequenceList" ItemsSource="{Binding ItemsSource, ElementName=PlanList}"
              SelectedItem="{Binding SelectedItem, ElementName=PlanList, Mode=TwoWay}"
              LiveCueId="{Binding LiveCueId, ElementName=PlanList}"
              Style="{StaticResource {x:Type ListBox}}" ItemTemplate="{StaticResource SequenceTemplate}" ItemContainerStyle="{StaticResource SequenceItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
              PreviewMouseLeftButtonUp="SequenceMouseUp" MouseDoubleClick="SequenceDoubleClick" AutomationProperties.Name="Secuencia visual del culto">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </local:OrderListBox>
        </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane>
            </ad:LayoutPanel>
          </ad:LayoutPanel>
<ad:LayoutAnchorablePane DockWidth="*" DockHeight="*" DockMinWidth="390" DockMinHeight="400">
<ad:LayoutAnchorable Title="Biblioteca y Biblia" ContentId="sources" CanClose="False" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
<Border x:Name="SourcesPanel" Background="#302D39" CornerRadius="8" Padding="12">
        <TabControl x:Name="ContentTabs" SelectionChanged="ContentTabChanged">
          <TabItem Header="Himnario y medios">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Buscar himno o contenido" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                  <TextBox x:Name="LibrarySearch" TextChanged="LibrarySearchChanged" KeyDown="LibrarySearchKeyDown" AutomationProperties.Name="Buscar en biblioteca" MinHeight="42" FontSize="17"/>
                </StackPanel>
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="Limpiar" Click="ClearLibrarySearchClick" VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="9,8" MinHeight="42" AutomationProperties.Name="Limpiar búsqueda"/>
              </Grid>
              <ListBox x:Name="LibraryFilter" Grid.Row="1" SelectedIndex="0" SelectionChanged="LibraryFilterChanged" ItemContainerStyle="{StaticResource FilterChip}" Margin="0,10,0,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Categoría de la biblioteca">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem Content="Todo"/><ListBoxItem Content="Himnos"/><ListBoxItem Content="Videos"/><ListBoxItem Content="Imágenes"/><ListBoxItem Content="Audio"/><ListBoxItem Content="Textos"/>
              </ListBox>
              <TextBlock x:Name="LibraryCountText" Grid.Row="2" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,8"/>
              <Grid Grid.Row="3">
                <ListBox x:Name="LibraryList" ItemTemplate="{StaticResource LibraryItemTemplate}" SelectionChanged="LibrarySelectionChanged" MouseDoubleClick="LibraryDoubleClick" AutomationProperties.Name="Biblioteca de contenidos"/>
                <TextBlock x:Name="LibraryEmpty" Text="Biblioteca vacía" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="18,30" TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="+ Añadir al orden" Click="AddLibraryToPlanClick" Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource SelectedBrush}" MinHeight="40"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Biblia">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="BibleNameText" Text="Biblia" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="BibleStatusText" Text="Sin Biblia cargada" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Libro" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleBookPicker" SelectionChanged="BibleBookChanged" MaxDropDownHeight="360" IsTextSearchEnabled="True" AutomationProperties.Name="Libro de la Biblia"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Capítulo" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleChapterPicker" SelectionChanged="BibleChapterChanged" MaxDropDownHeight="300" AutomationProperties.Name="Capítulo de la Biblia"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Versículo" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox x:Name="BibleVersePicker" SelectionChanged="BibleVerseChanged" MaxDropDownHeight="300" AutomationProperties.Name="Versículo de la Biblia"/></StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Cita o frase" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="BibleQuery" KeyDown="BibleQueryKeyDown" AutomationProperties.Name="Cita o palabras de la Biblia" FontSize="16" MinHeight="40"/>
                  <Button Grid.Column="1" Content="Buscar" Click="SearchBibleClick" Margin="6,0,0,0"/>
                </Grid>
              </StackPanel>
              <TextBlock Grid.Row="3" x:Name="BibleResultText" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
              <ListBox Grid.Row="4" x:Name="BibleResults" SelectionChanged="BibleSelectionChanged" AutomationProperties.Name="Resultados de Biblia">
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                  <TextBlock Text="{Binding Reference}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="AddSelectedBibleButton" Content="+ Versículo al orden" Click="AddSelectedBibleToPlanClick" MinHeight="40"/>
                <Button Grid.Column="1" x:Name="AddBiblePassageButton" Content="Pasaje" Click="AddBibleToPlanClick" Visibility="Collapsed" Margin="8,0,0,0" MinHeight="40"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Texto">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Título" Style="{StaticResource MutedText}"/>
                <TextBox x:Name="TextTitleBox" Text="Bienvenidos" Margin="0,6,0,12" AutomationProperties.Name="Título del texto"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Mensaje para la congregación" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Grid.Row="2" x:Name="TextBodyBox" Text="Nos alegra compartir este culto contigo." AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="17" AutomationProperties.Name="Texto para proyectar"/>
              <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Button Content="Preparar texto" Click="PrepareTextClick" MinHeight="40"/>
                <Button Content="+ Guardar en biblioteca y orden" Click="SaveTextClick" Margin="0,6,0,0" MinHeight="40"/>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
</ad:LayoutAnchorable>
</ad:LayoutAnchorablePane>
        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>
    <Grid Grid.Row="3" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
