<Window x:Class="Culto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Culto.Desktop"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
        xmlns:projection="clr-namespace:Culto.Desktop.Projection"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Culto Studio — Consola de iglesia" Width="1480" Height="900"
        MinWidth="1200" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:OrderNumberConverter x:Key="OrderNumberConverter"/>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/><Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="PlayerTime" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerLoop" TargetType="CheckBox">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid>
          <Border x:Name="LoopSurface" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
          <Path Data="M 5,7 L 16,7 M 13,4 L 16,7 L 13,10 M 15,15 L 4,15 M 7,12 L 4,15 L 7,18"
                Width="16" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse x:Name="LoopEnabled" Width="3" Height="3" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource SelectedBrush}"/>
            <Setter TargetName="LoopEnabled" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="LoopSurface" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LoopSurface" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="SkipBackIcon">
      <Grid Width="22" Height="22">
        <Path Data="M 4,7 A 8,8 0 1 1 3,15 M 4,2 L 4,7 L 9,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock Text="10" FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,3,0,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SkipForwardIcon">
      <Grid Width="22" Height="22">
        <Path Data="M 18,7 A 8,8 0 1 0 19,15 M 18,2 L 18,7 L 13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock Text="10" FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,3,0,0"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent">
              <Border x:Name="Grip" Background="{StaticResource BorderBrush}" Width="2" Height="42" CornerRadius="1" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AmberBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadiusConverter}}" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ActionBrush}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="OrderItemTemplate">
      <Grid ToolTip="{Binding Title}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="26" Height="28" Background="Transparent" VerticalAlignment="Top">
          <TextBlock x:Name="OrderNumber" Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}"
                     FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock x:Name="OrderKind" Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="EN VIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnActionBrush}" Margin="10,0,0,0"
                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive)}" Value="True">
          <Setter TargetName="OrderNumber" Property="Foreground" Value="{StaticResource OnActionBrush}"/>
          <Setter TargetName="OrderKind" Property="Foreground" Value="{StaticResource OnActionBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="LibraryItemTemplate">
      <Grid ToolTip="{Binding Title}" MinHeight="30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="KindBadge" Width="28" Height="28" CornerRadius="14" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
          <Path x:Name="KindIcon" Data="M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,7 L 13,7 M 7,10 L 13,10 M 7,13 L 11,13"
                Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Width="15" Height="17" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Video">
          <Setter TargetName="KindIcon" Property="Data" Value="M 5,3 L 17,10 L 5,17 Z"/>
          <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource RaisedBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Audio">
          <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource RaisedBrush}"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 8,14 L 8,4 L 17,2 L 17,12 M 8,14 C 8,18 1,18 1,15 C 1,12 8,12 8,14 M 17,12 C 17,16 10,16 10,13 C 10,10 17,10 17,12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image">
          <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LiveSurfaceBrush}"/>
          <Setter TargetName="KindIcon" Property="Data" Value="M 2,3 L 18,3 L 18,17 L 2,17 Z M 2,14 L 8,8 L 13,13 L 16,10 L 18,12"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SequenceItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource LiveBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="SequenceTemplate">
      <StackPanel Width="124" ToolTip="{Binding Title}">
        <Grid Height="70">
          <local:CueThumbnail Cue="{Binding}"/>
          <Border Background="#CC1F2023" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.AbsoluteIndex), Converter={StaticResource OrderNumberConverter}}" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
          </Border>
          <Ellipse Width="6" Height="6" Fill="{StaticResource LiveBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(local:OrderListBox.IsLive), Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
        <TextBlock Text="{Binding Title}" FontSize="10" Margin="2,3,2,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
    </DataTemplate>
    <local:MediaPathConverter x:Key="MediaPathConverter"/>
    <sys:Double x:Key="MediaThumbnailHeight">94</sys:Double>
    <sys:Double x:Key="MediaTileHeight">160</sys:Double>
    <ItemsPanelTemplate x:Key="MediaTilesPanel"><local:MediaTilePanel ItemWidth="184" ItemHeight="{DynamicResource MediaTileHeight}"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="MediaRowsPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
    <Style x:Key="MediaTileItem" TargetType="ListBoxItem" BasedOn="{StaticResource SequenceItem}">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <DataTemplate x:Key="MediaTileTemplate">
      <Grid ToolTip="{Binding FilePath}" Margin="0,0,0,2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="Black" CornerRadius="18" SizeChanged="MonitorFrameSizeChanged"><local:MediaThumbnail Cue="{Binding}" Height="{DynamicResource MediaThumbnailHeight}"/></Border>
        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="1,6,1,2" TextTrimming="CharacterEllipsis"/>
        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Right" Text="{Binding FilePath, Converter={StaticResource MediaPathConverter}, ConverterParameter=Extension}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MediaRowTemplate">
      <Grid ToolTip="{Binding FilePath}" MinHeight="34">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" FontSize="17"/>
        <StackPanel Grid.Column="1" Margin="0,0,10,0">
          <TextBlock Text="{Binding FilePath, Converter={StaticResource MediaPathConverter}, ConverterParameter=FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Kind, Converter={StaticResource CueKindConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding FilePath, Converter={StaticResource MediaPathConverter}, ConverterParameter=Extension}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="OrderRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="24" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <Border x:Name="Stripe" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2" Margin="0,6"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}"/><Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="local:OrderListBox.IsLive" Value="True">
            <Setter TargetName="Row" Property="Background" Value="{StaticResource LiveBrush}"/>
            <Setter TargetName="Stripe" Property="Background" Value="{StaticResource OnActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnActionBrush}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AmberBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10,0,10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="6,0,6,4">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FileMenuButton" Content="_Archivo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Archivo">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Nuevo culto" Click="NewPlanClick"/>
            <MenuItem Header="Abrir culto…" Click="OpenPlanClick"/>
            <MenuItem Header="Guardar culto…" Click="SaveServiceClick"/>
            <MenuItem Header="Cultos guardados…" Click="SavedServicesClick"/>
            <MenuItem Header="Guardar una copia…" InputGestureText="Ctrl+S" Click="SavePlanClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="LibraryMenuButton" Content="_Biblioteca" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Administrar biblioteca">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Añadir archivos…" Click="ImportFilesClick"/>
            <MenuItem Header="Importar carpeta de himnos…" Click="ImportFolderClick"/>
            <MenuItem Header="Importar Biblia…" Click="ImportBibleClick"/>
            <MenuItem Header="Colecciones de videos…" Click="VideoCollectionsClick"/>
            <MenuItem Header="Añadir video a una colección…" Click="AddVideoToCollectionClick"/>
            <Separator/>
            <MenuItem Header="Captura de imagen de una pantalla…" Click="CaptureClick"/>
            <MenuItem Header="Editar el contenido seleccionado…" Click="EditLibraryClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="SettingsMenuButton" Content="_Configuración" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick" AutomationProperties.Name="Configuración">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Pantallas y salida…" Click="DisplayClick"/>
            <MenuItem Header="Transición del sistema…" Click="TransitionSettingsClick"/>
            <MenuItem Header="Presentador USB">
              <MenuItem x:Name="PresenterEnabledMenu" Header="Control en segundo plano" IsCheckable="True" Click="TogglePresenterClick" ToolTip="Captura Av Pág y Re Pág aunque otra aplicación esté activa."/>
              <MenuItem x:Name="PresenterArrowsMenu" Header="Usar flechas izquierda y derecha" IsCheckable="True" Click="TogglePresenterArrowsClick" ToolTip="Estas teclas del teclado también controlarán la salida mientras esté activado."/>
            </MenuItem>
            <MenuItem Header="Logo…" Click="LogoSettingsClick"/>
            <MenuItem Header="Volver al contenido" Click="RestoreLogoContentClick"/>
            <MenuItem x:Name="RemoteButton" Header="Mando móvil…" Click="RemoteClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button x:Name="WorkspaceMenuButton" Content="Espacio de trabajo" Style="{StaticResource MenuBarButton}" Click="OpenActionsClick">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Vista previa" Tag="preview" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="En pantalla" Tag="output" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Orden del culto" Tag="order" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Himnario" Tag="sources" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Biblia" Tag="bible" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Texto" Tag="text" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="YouTube" Tag="youtube" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Secuencia" Tag="sequence" Click="ShowWorkspacePanelClick"/>
            <MenuItem Header="Medios" Tag="media" Click="ShowWorkspacePanelClick"/>
            <Separator/>
            <MenuItem Header="Principal" Tag="principal" Click="WorkspacePresetClick"/>
            <MenuItem Header="Compacta" Tag="compacta" Click="WorkspacePresetClick"/>
            <MenuItem Header="Proyección" Tag="proyeccion" Click="WorkspacePresetClick"/>
            <Separator/>
            <MenuItem Header="Guardar distribución" Click="SaveDockLayoutClick"/>
            <MenuItem Header="Restablecer diseño principal" Click="ResetDockLayoutClick"/>
            <MenuItem Header="Recuperar distribución anterior" Click="RestoreLegacyWorkspaceClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
      <Grid x:Name="ConsoleHeaderDetails" Grid.Row="1" Margin="0,6,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Consola" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="ConsoleDateText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource PanelBrush}" CornerRadius="22" Padding="14,3" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Culto actual" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="PlanNameBox" Text="Culto del sábado" Width="166" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="2,5" MinHeight="32" LostFocus="PlanNameChanged" AutomationProperties.Name="Nombre del culto"/>
              <Border Background="{StaticResource InputBrush}" CornerRadius="14" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HeaderSaveState" Text="Local" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Border>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="22" Padding="14,10" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Progreso" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="HeaderProgressText" Text="0/0" FontSize="12" FontWeight="SemiBold" Margin="10,0"/><ProgressBar x:Name="HeaderProgress" Width="60" Height="5" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center" BorderThickness="0"/></StackPanel>
          </Border>
          <Button x:Name="RemoteTopButton" Click="RemoteClick" Background="{StaticResource TextBrush}" Foreground="{StaticResource OnActionBrush}" BorderThickness="0" Padding="14,7" MinHeight="40" AutomationProperties.Name="Control remoto">
            <StackPanel Orientation="Horizontal"><Path Data="M 3,1 L 11,1 Q 13,1 13,3 L 13,19 Q 13,21 11,21 L 3,21 Q 1,21 1,19 L 1,3 Q 1,1 3,1 M 5,18 L 9,18" Width="12" Height="18" Stretch="Uniform" Stroke="{StaticResource OnActionBrush}" StrokeThickness="1.5" Margin="0,0,9,0"/><TextBlock Text="Control remoto" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E2E3E5" CornerRadius="14" Padding="8,5" Margin="9,0,-5,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RemoteConnectionDot" Fill="{StaticResource MutedBrush}" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="RemoteConnectionText" Text="Desactivado" FontSize="10"/></StackPanel></Border></StackPanel>
          </Button>
          <Border Background="{StaticResource LiveSurfaceBrush}" CornerRadius="22" Padding="13,10" Margin="12,0,0,0"><StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OutputIndicator" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource LiveBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="SIN SALIDA"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="ENSAYO"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="NEGRO"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=OutputModeText}" Value="LOGO"><Setter Property="Fill" Value="{StaticResource AmberBrush}"/></DataTrigger>
                </Style.Triggers>
              </Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding Text, ElementName=OutputModeText}" Foreground="{Binding Fill, ElementName=OutputIndicator}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>

          </StackPanel></Border>
        </StackPanel>
      </Grid>
    </Grid>

