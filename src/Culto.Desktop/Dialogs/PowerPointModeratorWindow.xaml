<Window x:Class="Culto.Desktop.Dialogs.PowerPointModeratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:projection="clr-namespace:Culto.Desktop.Projection"
        Title="Vista de moderador" Width="1120" Height="740" MinWidth="860" MinHeight="580"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource ConsoleFont}" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Vista de moderador" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModeratorTitle" Foreground="{StaticResource MutedBrush}" Margin="0,5,18,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource LiveSurfaceBrush}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
        <TextBlock Text="Solo moderador" Foreground="{StaticResource AccentTextBrush}" FontSize="12"/>
      </Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="ModeratorStatus" DockPanel.Dock="Right" Foreground="{StaticResource AccentTextBrush}" FontSize="12" TextAlignment="Right"/>
            <TextBlock Text="EN PANTALLA" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </DockPanel>
          <Border Grid.Row="1" Background="Black" ClipToBounds="True">
            <projection:OutputMonitor x:Name="ModeratorMonitor"/>
          </Border>
          <TextBlock x:Name="ModeratorPosition" Grid.Row="2" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="1.25*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="SIGUIENTE DIAPOSITIVA" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
            <Grid Grid.Row="1" Background="Black">
              <TextBlock x:Name="ModeratorNextEmpty" Text="Fin de la presentación" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12"/>
              <Image x:Name="ModeratorNextImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Vista previa de la siguiente diapositiva"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="A−" Click="SmallerNotesClick" MinWidth="36" MinHeight="30" Padding="6,2" Margin="0,0,4,0" AutomationProperties.Name="Reducir tamaño de las notas"/>
                <Button Content="A+" Click="LargerNotesClick" MinWidth="36" MinHeight="30" Padding="6,2" AutomationProperties.Name="Aumentar tamaño de las notas"/>
              </StackPanel>
              <TextBlock Text="NOTAS" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="ModeratorNotesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="ModeratorNotes" FontSize="18" TextWrapping="Wrap" Padding="0,0,8,0"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ModeratorPreviousButton" Content="‹ Anterior" Click="PreviousClick" MinHeight="42" MinWidth="112" Margin="0,0,8,0"/>
        <Button x:Name="ModeratorNextButton" Content="Siguiente ›" Click="NextClick" MinHeight="42" MinWidth="124" Background="{StaticResource ActionBrush}" Foreground="{StaticResource OnActionBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="ModeratorPauseButton" Content="Pausar" Click="PauseClick" MinHeight="42" MinWidth="90" Margin="8,0,0,0"/>
        <Button x:Name="ModeratorRestartButton" Content="Reiniciar" Click="RestartClick" MinHeight="42" MinWidth="90" Margin="8,0,0,0"/>
        <Button x:Name="ModeratorBlackoutButton" Content="Pantalla negra" Click="BlackoutClick" MinHeight="42" MinWidth="130" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="← →  /  Av Pág · Re Pág: navegar     F8: negro     Esc: cerrar esta vista" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
  </Grid>
</Window>
