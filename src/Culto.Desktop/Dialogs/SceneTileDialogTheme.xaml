<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SceneEditorOption" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F5F5F5"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Option" Background="Transparent" BorderBrush="Transparent"
                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True">
            <Setter TargetName="Option" Property="Background" Value="#353535"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Option" Property="Background" Value="#303426"/>
            <Setter TargetName="Option" Property="BorderBrush" Value="#BEF264"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="Option" Property="BorderBrush" Value="#BEF264"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Option" Property="Opacity" Value="0.4"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="SceneEditorComboTemplate" TargetType="ComboBox">
    <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
      <Border x:Name="ComboFrame" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="18"/>
      <ToggleButton Focusable="False" ClickMode="Press" Style="{x:Null}"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" CornerRadius="18">
              <Path Data="M0 0 L4 4 L8 0" Stroke="#A3A3A3" StrokeThickness="1.5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
            </Border>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="12,8,36,8" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
             IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
        <Border Background="#242424" BorderBrush="#454545" BorderThickness="1" CornerRadius="18"
                Padding="5" Margin="0,5,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboRoot" Property="Opacity" Value="0.4"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
